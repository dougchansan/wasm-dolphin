+{
+  DolphinWebTexDiag_CopyDsts().insert(a);
+}
+static bool DolphinWebTexDiag_WasCopyDst(u32 a)
+{
+  return DolphinWebTexDiag_CopyDsts().count(a) != 0;
+}

{
  "mode": "screening",
  "blockCount": 2,
  "maxBlockCount": 2,
  "hypothesis": "Skipping sampled clean FIFO tail Flush/RefreshPeekCache work improves fixed-work hardware-WGPU throughput without changing emulated work.",
  "primaryMetric": "metrics.fixedEmulatedWork.throughputGameSpeedPercent",
  "direction": "higher",
  "minimumEffectPercent": 1,
  "overheadGate": {
    "maximumRegressionPercent": 2,
    "semanticWork": [
      {
        "path": "fixedEmulatedWork.actualCoreTickDelta",
        "maximumDifferencePercent": 0.25
      },
      {
        "path": "fixedEmulatedWork.actualFrameDelta",
        "maximumDifferencePercent": 0.25
      }
    ]
  },
  "invalidationRules": [
    "fixture, save-state checkpoint, selected core, or fixed emulated work differs",
    "tail-gate evidence is missing, malformed, changes epoch or period, or does not match the requested arm",
    "the enabled arm has no sampled clean tails or reports dirty state at a skipped tail",
    "null-drain ownership, record conservation, quiescence, or workload equivalence fails",
    "any core, worker, command-stream, audio, or input correctness gate fails"
  ],
  "armA": {
    "name": "wgpu-tail-gate-off",
    "cacheState": "disabled",

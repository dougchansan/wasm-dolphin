+static u32 ElapsedProfileMicros(std::chrono::steady_clock::time_point start,
+                                std::chrono::steady_clock::time_point end)
+{
+  return static_cast<u32>(
+      std::chrono::duration_cast<std::chrono::microseconds>(end - start).count());
+}
+
+static void FastEncodeXFB(u8* xfb_in_ram, u32 memory_stride,
+                          const MathUtil::Rectangle<int>& source_rect, float y_scale, int mode,
+                          std::chrono::steady_clock::time_point profile_start)
+{
+  const int left = source_rect.left;
+  const int top = source_rect.top;
+  const int src_width = source_rect.GetWidth();
+  const int src_height = source_rect.GetHeight();
+  const int dst_height = std::max(1, static_cast<int>(src_height * y_scale));
+
+  yuv422_packed* dst = reinterpret_cast<yuv422_packed*>(xfb_in_ram);
+  const int even_width = src_width & ~1;
+
+  for (int dst_y = 0; dst_y < dst_height; ++dst_y)
+  {
+    yuv422_packed* row = dst + static_cast<std::size_t>(dst_y) * memory_stride;
+    if (mode > 1 && dst_y > 0 && (dst_y & 1) != 0)
+    {
+      std::memcpy(row, row - memory_stride, static_cast<std::size_t>(src_width) * sizeof(*row));
+      continue;
+    }
+
+    const auto scaled_y =
+        static_cast<int>((static_cast<std::int64_t>(dst_y) * src_height) / dst_height);
+    u16 src_y =
+        static_cast<u16>(std::clamp(top + scaled_y, 0, static_cast<int>(EFB_HEIGHT) - 1));
+    if (mode > 0)
+      src_y &= ~u16{1};
+
+    for (int x = 0; x < even_width; x += 2)
+    {
+      u16 src_x0 =
+          static_cast<u16>(std::clamp(left + x, 0, static_cast<int>(EFB_WIDTH) - 1));
+      u16 src_x1 =
+          static_cast<u16>(std::clamp(left + x + 1, 0, static_cast<int>(EFB_WIDTH) - 1));
+      if (mode > 0)
+      {
+        src_x0 &= ~u16{1};
+        src_x1 = src_x0;
+      }
+      const yuv444 yuv0 = ConvertColorToYUV(GetColor(src_x0, src_y));
+      const yuv444 yuv1 = mode > 1 ? yuv0 : ConvertColorToYUV(GetColor(src_x1, src_y));
+
+      row[x].Y = yuv0.Y + 16;
+      row[x].UV = 128 + yuv0.U;
+      row[x + 1].Y = yuv1.Y + 16;
+      row[x + 1].UV = 128 + yuv1.V;
+    }
+
+    if (even_width != src_width)
+    {
+      u16 src_x =
+          static_cast<u16>(std::clamp(left + even_width, 0, static_cast<int>(EFB_WIDTH) - 1));
+      if (mode > 0)
+        src_x &= ~u16{1};
+      const yuv444 yuv = ConvertColorToYUV(GetColor(src_x, src_y));
+      row[even_width].Y = yuv.Y + 16;
+      row[even_width].UV = 128 + yuv.U;
+    }
+  }
+
+  const auto profile_done = std::chrono::steady_clock::now();
+  const u32 total_us = ElapsedProfileMicros(profile_start, profile_done);
+  DolphinWeb_RecordSoftwareXfbEncodeProfile(total_us, 0, total_us, static_cast<u32>(src_width),
+                                            static_cast<u32>(src_height),
+                                            static_cast<u32>(dst_height));
+}
+

+  EmitStateLoadF64(body, PsOffset(layout, inst.FA, 0));
+  EmitStateLoadF64(body, PsOffset(layout, inst.FA, 0));
+  body.push_back(0x61);
+  EmitStateLoadF64(body, PsOffset(layout, inst.FB, 0));
+  EmitStateLoadF64(body, PsOffset(layout, inst.FB, 0));
+  body.push_back(0x61);
+  body.push_back(0x71);

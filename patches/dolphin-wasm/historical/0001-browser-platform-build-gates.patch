+static bool IsFastPureIntegerInstruction(UGeckoInstruction inst)
+{
+  switch (inst.OPCD)
+  {
+  case 7:   // mulli
+  case 8:   // subfic
+  case 10:  // cmpli
+  case 11:  // cmpi
+  case 12:  // addic
+  case 13:  // addic.
+  case 14:  // addi
+  case 15:  // addis
+  case 21:  // rlwinmx
+  case 24:  // ori
+  case 25:  // oris
+  case 26:  // xori
+  case 27:  // xoris
+  case 28:  // andi_rc
+  case 29:  // andis_rc
+  case 32:  // lwz
+  case 33:  // lwzu
+  case 34:  // lbz
+  case 35:  // lbzu
+  case 36:  // stw
+  case 37:  // stwu
+  case 38:  // stb
+  case 39:  // stbu
+  case 40:  // lhz
+  case 41:  // lhzu
+  case 42:  // lha
+  case 43:  // lhau
+  case 44:  // sth
+  case 45:  // sthu
+  case 46:  // lmw
+  case 47:  // stmw
+    return true;
+  case 31:
+    switch (inst.SUBOP10)
+    {
+    case 0:    // cmp
+    case 87:   // lbzx
+    case 119:  // lbzux
+    case 215:  // stbx
+    case 247:  // stbux
+    case 279:  // lhzx
+    case 311:  // lhzux
+    case 343:  // lhax
+    case 375:  // lhaux
+    case 407:  // sthx
+    case 439:  // sthux
+    case 23:   // lwzx
+    case 28:   // andx
+    case 32:   // cmpl
+    case 55:   // lwzux
+    case 151:  // stwx
+    case 183:  // stwux
+    case 266:  // addx
+    case 316:  // xorx
+    case 444:  // orx
+      return !inst.OE;
+    default:
+      return false;
+    }
+  default:
+    return false;
+  }
+}
+
+static bool IsFastBranchInstruction(UGeckoInstruction inst)
+{
+  if (inst.OPCD == 16 || inst.OPCD == 18)
+    return true;
+  return inst.OPCD == 19 && (inst.SUBOP10 == 16 || inst.SUBOP10 == 528);
+}
+
+static bool IsFastFloatInstruction(UGeckoInstruction inst)
+{
+  switch (inst.OPCD)
+  {
+  case 48:  // lfs
+  case 50:  // lfd
+  case 52:  // stfs
+    return true;
+  case 31:
+    if (inst.Rc)
+      return false;
+    return inst.SUBOP10 == 535 || inst.SUBOP10 == 663 || inst.SUBOP10 == 983;  // lfsx, stfsx, stfiwx
+  default:
+    break;
+  }
+
+  if (inst.OPCD == 59)
+  {
+    if (inst.Rc)
+      return false;
+    return inst.SUBOP5 == 20 || inst.SUBOP5 == 21 || inst.SUBOP5 == 25 ||
+           inst.SUBOP5 == 29 || inst.SUBOP5 == 30;  // fsubs, fadds, fmuls, fmadds, fnmsubs
+  }
+
+  if (inst.OPCD == 63)
+  {
+    if (inst.Rc)
+      return false;
+    return inst.SUBOP10 == 15 || inst.SUBOP10 == 40 || inst.SUBOP10 == 72 ||
+           inst.SUBOP10 == 136 || inst.SUBOP10 == 264;  // fctiwzx, fnegx, fmrx, fnabsx, fabsx
+  }
+
+  return false;
+}

+    const u32 first_mask = ~0u << (first_bit % 32);
+    const u32 last_mask_bits = end_bit % 32;
+    const u32 last_mask = last_mask_bits == 0 ? ~0u : (1u << last_mask_bits) - 1;
+    bool any = false;
+
+    if (first_word == last_word)
+    {
+      const u32 mask = first_mask & last_mask;
+      any = (m_valid_block[first_word] & mask) != 0;
+      m_valid_block[first_word] &= ~mask;
+      return any;
+    }
+
+    any |= (m_valid_block[first_word] & first_mask) != 0;
+    m_valid_block[first_word] &= ~first_mask;
+
+    for (u32 word = first_word + 1; word < last_word; ++word)
+    {
+      any |= m_valid_block[word] != 0;
+      m_valid_block[word] = 0;
+    }
+
+    any |= (m_valid_block[last_word] & last_mask) != 0;
+    m_valid_block[last_word] &= ~last_mask;
+    return any;
+  }

+u32 DecodeMfsprIndex(UGeckoInstruction inst)
+{
+  return ((inst.SPR & 0x1f) << 5) | ((inst.SPR >> 5) & 0x1f);
+}
+
+u32 DecodeMtsprIndex(UGeckoInstruction inst)
+{
+  return (inst.SPRU << 5) | (inst.SPRL & 0x1f);
+}

+class DolphinWebThread
+{
+public:
+  DolphinWebThread() = default;
+
+  template <typename Function>
+  explicit DolphinWebThread(Function&& function, bool transfer_canvas = false)
+  {
+    Start(std::forward<Function>(function), transfer_canvas);
+  }
+
+  DolphinWebThread(const DolphinWebThread&) = delete;
+  DolphinWebThread& operator=(const DolphinWebThread&) = delete;
+
+  DolphinWebThread(DolphinWebThread&& other) noexcept
+      : m_thread(other.m_thread), m_joinable(std::exchange(other.m_joinable, false))
+  {
+  }
+
+  DolphinWebThread& operator=(DolphinWebThread&& other) noexcept
+  {
+    if (this != &other)
+    {
+      if (joinable())
+        std::terminate();
+      m_thread = other.m_thread;
+      m_joinable = std::exchange(other.m_joinable, false);
+    }
+    return *this;
+  }
+
+  ~DolphinWebThread()
+  {
+    if (joinable())
+      std::terminate();
+  }
+
+  bool joinable() const { return m_joinable; }
+
+  void join()
+  {
+    if (!m_joinable)
+      return;
+    pthread_join(m_thread, nullptr);
+    m_joinable = false;
+  }
+
+private:
+  template <typename Function>
+  void Start(Function&& function, bool transfer_canvas)
+  {
+    using FunctionType = std::decay_t<Function>;
+    auto* owned_function = new FunctionType(std::forward<Function>(function));
+
+    pthread_attr_t attr;
+    pthread_attr_init(&attr);
+    if (transfer_canvas)
+      emscripten_pthread_attr_settransferredcanvases(&attr, "#canvas");
+
+    const int result = pthread_create(
+        &m_thread, &attr,
+        [](void* pointer) -> void* {
+          std::unique_ptr<FunctionType> function(static_cast<FunctionType*>(pointer));
+          (*function)();
+          return nullptr;
+        },
+        owned_function);
+    pthread_attr_destroy(&attr);
+
+    if (result != 0)
+    {
+      delete owned_function;
+      PanicAlertFmtT("pthread_create failed: {0}", result);
+      std::terminate();
+    }
+
+    m_joinable = true;
+  }
+
+  pthread_t m_thread{};
+  bool m_joinable = false;
+};

+bool IsPpcWasmDirectInstructionCandidate(const PPCAnalyst::CodeOp& op)
+{
+  if (op.skip)
+    return true;
+
+  const UGeckoInstruction inst = op.inst;
+
+  // Direct-tier JIT admits FPU only when this file has a specialized emitter or a known hot helper
+  // fallback. Letting every FPU helper through regresses Melee's title-screen blocks.
+  if ((op.opinfo->flags & FL_USE_FPU) != 0)
+    return IsPpcWasmSpecializedFpuInstruction(inst) || IsPpcWasmDirectHelperFpuInstruction(inst);
+
+  switch (inst.OPCD)
+  {
+  case 7:   // mulli
+  case 8:   // subfic
+  case 10:  // cmpli
+  case 11:  // cmpi
+  case 12:  // addic
+  case 13:  // addic.
+  case 14:  // addi
+  case 15:  // addis
+  case 16:  // bcx
+  case 18:  // bx
+  case 20:  // rlwimix
+  case 21:  // rlwinmx
+  case 23:  // rlwnmx
+  case 24:  // ori
+  case 25:  // oris
+  case 26:  // xori
+  case 27:  // xoris
+  case 28:  // andi_rc
+  case 29:  // andis_rc
+  case 32:  // lwz
+  case 33:  // lwzu
+  case 34:  // lbz
+  case 35:  // lbzu
+  case 36:  // stw
+  case 37:  // stwu
+  case 38:  // stb
+  case 39:  // stbu
+  case 40:  // lhz
+  case 41:  // lhzu
+  case 42:  // lha
+  case 43:  // lhau
+  case 44:  // sth
+  case 45:  // sthu
+  case 46:  // lmw
+  case 47:  // stmw
+    return true;
+
+  case 19:
+    if (inst.SUBOP10 == 16 || inst.SUBOP10 == 528 || inst.SUBOP10 == 150)
+      return true;
+    switch (inst.SUBOP10)
+    {
+    case 0:
+    case 33:
+    case 129:
+    case 193:
+    case 225:
+    case 257:
+    case 289:
+    case 417:
+    case 449:
+      return true;
+    default:
+      return false;
+    }
+
+  case 31:
+    switch (inst.SUBOP10)
+    {
+    case 0:    // cmp
+    case 11:   // mulhwux
+    case 23:   // lwzx
+    case 24:   // slwx
+    case 26:   // cntlzwx
+    case 28:   // andx
+    case 32:   // cmpl
+    case 55:   // lwzux
+    case 60:   // andcx
+    case 75:   // mulhwx
+    case 87:   // lbzx
+    case 119:  // lbzux
+    case 124:  // norx
+    case 151:  // stwx
+    case 183:  // stwux
+    case 215:  // stbx
+    case 246:  // dcbtst
+    case 247:  // stbux
+    case 278:  // dcbt
+    case 279:  // lhzx
+    case 311:  // lhzux
+    case 316:  // xorx
+    case 343:  // lhax
+    case 375:  // lhaux
+    case 407:  // sthx
+    case 439:  // sthux
+    case 444:  // orx
+    case 476:  // nandx
+    case 536:  // srwx
+    case 598:  // sync
+    case 792:  // srawx
+    case 824:  // srawix
+    case 922:  // extshx
+    case 954:  // extsbx
+      return true;
+    case 8:    // subfcx
+    case 10:   // addcx
+    case 40:   // subfx
+    case 104:  // negx
+    case 136:  // subfex
+    case 138:  // addex
+    case 202:  // addzex
+    case 235:  // mullwx
+    case 266:  // addx
+    case 459:  // divwux
+    case 491:  // divwx
+      return !inst.OE;
+    case 19:   // mfcr
+    case 144:  // mtcrf
+      return true;
+    case 339:  // mfspr
+    {
+      const u32 spr_index = DecodeMfsprIndex(inst);
+      return spr_index == SPR_XER || IsDirectSimpleMfspr(spr_index);
+    }
+    case 467:  // mtspr
+    {
+      const u32 spr_index = DecodeMtsprIndex(inst);
+      return spr_index == SPR_XER || IsDirectSimpleMtspr(spr_index);
+    }
+    default:
+      return false;
+    }
+
+  default:
+    return false;
+  }
+}

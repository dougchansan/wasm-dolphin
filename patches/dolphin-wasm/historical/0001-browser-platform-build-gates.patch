+      EmitStateStoreU32Prefix(body);
+      EmitLocalGet(body, 3);
+      EmitStateStoreU32Suffix(body, GprOffset(layout, inst.RD));
+      if (inst.Rc)
+        EmitUpdateCr0FromLocal(body, layout, 3);
+      return true;
+    }
+    if (inst.SUBOP10 == 459 && !inst.OE)
+    {
+      EmitStateLoadU32(body, GprOffset(layout, inst.RB));
+      body.push_back(0x45);
+      body.push_back(0x04);
+      body.push_back(0x7f);
+      EmitI32Const(body, 0);
+      body.push_back(0x05);
+      EmitStateLoadU32(body, GprOffset(layout, inst.RA));
+      EmitStateLoadU32(body, GprOffset(layout, inst.RB));
+      body.push_back(0x6e);
+      body.push_back(0x0b);
+      EmitLocalSet(body, 3);
+      EmitStateStoreU32Prefix(body);
+      EmitLocalGet(body, 3);
+      EmitStateStoreU32Suffix(body, GprOffset(layout, inst.RD));
+      if (inst.Rc)
+        EmitUpdateCr0FromLocal(body, layout, 3);
+      return true;
+    }
+    if (inst.SUBOP10 == 792)
+    {
+      EmitStateLoadU32(body, GprOffset(layout, inst.RB));
+      EmitI32Const(body, 0x20);
+      body.push_back(0x71);
+      body.push_back(0x04);
+      body.push_back(0x40);
+
+      EmitStateLoadU32(body, GprOffset(layout, inst.RS));
+      EmitI32Const(body, 0);
+      body.push_back(0x48);
+      EmitLocalSet(body, 2);
+      EmitI32Const(body, 0);
+      EmitLocalGet(body, 2);
+      body.push_back(0x6b);
+      EmitLocalSet(body, 3);
+
+      body.push_back(0x05);
+
+      EmitStateLoadU32(body, GprOffset(layout, inst.RB));
+      EmitI32Const(body, 0x1f);
+      body.push_back(0x71);
+      EmitLocalSet(body, 2);
+      EmitStateLoadU32(body, GprOffset(layout, inst.RS));
+      EmitLocalGet(body, 2);
+      body.push_back(0x75);
+      EmitLocalSet(body, 3);
+
+      EmitLocalGet(body, 2);
+      EmitI32Const(body, 0);
+      body.push_back(0x47);
+      EmitStateLoadU32(body, GprOffset(layout, inst.RS));
+      EmitI32Const(body, 32);
+      EmitLocalGet(body, 2);
+      body.push_back(0x6b);
+      body.push_back(0x74);
+      EmitLocalGet(body, 3);
+      body.push_back(0x71);
+      EmitI32Const(body, 0);
+      body.push_back(0x47);
+      body.push_back(0x71);
+      EmitLocalSet(body, 2);
+      body.push_back(0x0b);
+
+      EmitStateStoreU32Prefix(body);
+      EmitLocalGet(body, 3);
+      EmitStateStoreU32Suffix(body, GprOffset(layout, inst.RA));
+      EmitStateStoreU32Prefix(body);
+      EmitLocalGet(body, 2);
+      EmitStateStoreU8Suffix(body, layout.xer_ca_offset);
+      if (inst.Rc)
+        EmitUpdateCr0FromLocal(body, layout, 3);
+      return true;
+    }
+    if (inst.SUBOP10 == 824)
+    {
+      EmitStateLoadU32(body, GprOffset(layout, inst.RS));
+      EmitI32Const(body, inst.SH);
+      body.push_back(0x75);
+      EmitLocalSet(body, 3);
+      EmitStateStoreU32Prefix(body);
+      EmitLocalGet(body, 3);
+      EmitStateStoreU32Suffix(body, GprOffset(layout, inst.RA));
+
+      EmitStateStoreU32Prefix(body);
+      if (inst.SH == 0)
+      {
+        EmitI32Const(body, 0);
+      }
+      else
+      {
+        EmitStateLoadU32(body, GprOffset(layout, inst.RS));
+        EmitI32Const(body, 32 - inst.SH);
+        body.push_back(0x74);
+        EmitLocalGet(body, 3);
+        body.push_back(0x71);
+        EmitI32Const(body, 0);
+        body.push_back(0x47);
+      }
+      EmitStateStoreU8Suffix(body, layout.xer_ca_offset);
+      if (inst.Rc)
+        EmitUpdateCr0FromLocal(body, layout, 3);
+      return true;
+    }
+    if (inst.SUBOP10 == 26)
+    {
+      EmitStateLoadU32(body, GprOffset(layout, inst.RS));
+      body.push_back(0x67);
+      EmitLocalSet(body, 3);
+      EmitStateStoreU32Prefix(body);
+      EmitLocalGet(body, 3);
+      EmitStateStoreU32Suffix(body, GprOffset(layout, inst.RA));
+      if (inst.Rc)
+        EmitUpdateCr0FromLocal(body, layout, 3);
+      return true;
+    }
+    if (inst.SUBOP10 == 536)
+    {
+      EmitStateLoadU32(body, GprOffset(layout, inst.RB));
+      EmitI32Const(body, 0x20);
+      body.push_back(0x71);
+      body.push_back(0x04);
+      body.push_back(0x7f);
+      EmitI32Const(body, 0);
+      body.push_back(0x05);
+      EmitStateLoadU32(body, GprOffset(layout, inst.RS));
+      EmitStateLoadU32(body, GprOffset(layout, inst.RB));
+      EmitI32Const(body, 0x1f);
+      body.push_back(0x71);
+      body.push_back(0x76);
+      body.push_back(0x0b);
+      EmitLocalSet(body, 3);
+      EmitStateStoreU32Prefix(body);
+      EmitLocalGet(body, 3);
+      EmitStateStoreU32Suffix(body, GprOffset(layout, inst.RA));
+      if (inst.Rc)
+        EmitUpdateCr0FromLocal(body, layout, 3);
+      return true;
+    }
+    if (inst.SUBOP10 == 922 || inst.SUBOP10 == 954)
+    {
+      EmitStateLoadU32(body, GprOffset(layout, inst.RS));
+      EmitI32Const(body, inst.SUBOP10 == 922 ? 16 : 24);
+      body.push_back(0x74);
+      EmitI32Const(body, inst.SUBOP10 == 922 ? 16 : 24);
+      body.push_back(0x75);
+      EmitLocalSet(body, 3);
+      EmitStateStoreU32Prefix(body);
+      EmitLocalGet(body, 3);
+      EmitStateStoreU32Suffix(body, GprOffset(layout, inst.RA));
+      if (inst.Rc)
+        EmitUpdateCr0FromLocal(body, layout, 3);
+      return true;
+    }
+    if (inst.SUBOP10 == 598)
+      return true;
+    switch (inst.SUBOP10)
+    {
+    case 28:
+    case 60:
+    case 124:
+    case 316:
+    case 444:
+    case 476:
+      break;
+    default:
+      return false;
+    }
+
+    EmitStateLoadU32(body, GprOffset(layout, inst.RS));
+    EmitStateLoadU32(body, GprOffset(layout, inst.RB));
+    switch (inst.SUBOP10)
+    {
+    case 28:  // andx
+      body.push_back(0x71);
+      break;
+    case 124:  // norx
+      body.push_back(0x72);
+      EmitI32Const(body, 0xffffffff);
+      body.push_back(0x73);
+      break;
+    case 60:  // andcx
+      EmitI32Const(body, 0xffffffff);
+      body.push_back(0x73);
+      body.push_back(0x71);
+      break;
+    case 316:  // xorx
+      body.push_back(0x73);
+      break;
+    case 444:  // orx
+      body.push_back(0x72);
+      break;
+    case 476:  // nandx
+      body.push_back(0x71);
+      EmitI32Const(body, 0xffffffff);
+      body.push_back(0x73);
+      break;
+    default:
+      return false;
+    }
+    EmitLocalSet(body, 3);
+    EmitStateStoreU32Prefix(body);
+    EmitLocalGet(body, 3);
+    EmitStateStoreU32Suffix(body, GprOffset(layout, inst.RA));
+    if (inst.Rc)
+      EmitUpdateCr0FromLocal(body, layout, 3);
+    return true;
+
+  case 63:
+    if (IsDoublePrecisionArithmeticSubop(inst.SUBOP5) && !inst.Rc)
+    {
+      EmitDoublePrecisionArithmetic(body, layout, op, downcount);
+      return true;
+    }
+    if ((inst.SUBOP10 == 0 || inst.SUBOP10 == 32) && !inst.Rc)
+    {
+      EmitFloatCompare(body, layout, op, downcount);
+      return true;
+    }
+    if (inst.SUBOP10 == 15)
+    {
+      EmitFctiwzFast(body, layout, op, downcount);
+      return true;
+    }
+    if (inst.SUBOP10 == 12 && !inst.Rc)
+    {
+      EmitFrsp(body, layout, op, downcount);
+      return true;
+    }
+    if ((inst.SUBOP10 == 40 || inst.SUBOP10 == 136 || inst.SUBOP10 == 264) && !inst.Rc)
+    {
+      EmitUnaryFpBitExact(body, layout, op, downcount);
+      return true;
+    }
+    if (inst.SUBOP10 == 72 && !inst.Rc)
+    {
+      EmitFpuAvailableOrFallback(body, op, layout, downcount);
+      EmitStateStoreU32Prefix(body);
+      EmitStateLoadI64(body, PsOffset(layout, inst.FB, 0));
+      EmitStateStoreI64Suffix(body, PsOffset(layout, inst.FD, 0));
+      body.push_back(0x05);
+      EmitFpCall(body, op, downcount);
+      body.push_back(0x0b);
+      return true;
+    }
+    return false;
+
+  default:
+    return false;
+  }
+}

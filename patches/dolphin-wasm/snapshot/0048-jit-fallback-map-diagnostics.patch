 using namespace Gen;
 
+#ifndef DOLPHIN_WEB_FALLBACK_MAP_DIAGNOSTICS
+#define DOLPHIN_WEB_FALLBACK_MAP_DIAGNOSTICS 0
+#endif
+
+namespace
+{
+#if DOLPHIN_WEB_FALLBACK_MAP_DIAGNOSTICS
+std::atomic<u64> s_fallback_dispatch_hit{0};
+std::atomic<u64> s_fallback_dispatch_empty_miss{0};
+std::atomic<u64> s_fallback_dispatch_collision_miss{0};
+std::atomic<u64> s_fallback_dispatch_slow_found{0};
+std::atomic<u64> s_fallback_dispatch_slow_missing{0};
+#endif
+}
+
+JitFallbackDispatchStats GetJitFallbackDispatchStats()
+{
+  JitFallbackDispatchStats stats;
+#if DOLPHIN_WEB_FALLBACK_MAP_DIAGNOSTICS
+  stats.enabled = true;
+  stats.hit = s_fallback_dispatch_hit.load(std::memory_order_relaxed);
+  stats.empty_miss = s_fallback_dispatch_empty_miss.load(std::memory_order_relaxed);
+  stats.collision_miss = s_fallback_dispatch_collision_miss.load(std::memory_order_relaxed);
+  stats.slow_found = s_fallback_dispatch_slow_found.load(std::memory_order_relaxed);
+  stats.slow_missing = s_fallback_dispatch_slow_missing.load(std::memory_order_relaxed);
+#endif
+  return stats;
+}

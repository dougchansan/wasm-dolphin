+u32 WebGPUGfx::AllocUboClassSlice(UboClass ubo_class, const void* data, u32 size)
+{
+  if (!m_ubo_compute_package_active)
+    return AllocUboSlice(data, size, BufferUploadRole::Ubo);
+  if (m_ubo_ring == 0 || data == nullptr || size == 0 || size > kUboSliceStride)
+  {
+    if (m_ubo_cache_active)
+      InvalidateUboSlices();
+    else
+      ResetUboComputePackageState();
+    return kUboOffNone;
+  }
+  if (m_ubo_compute_package.full() && !FlushUboComputePackage())
+    return kUboOffNone;
+  if (m_ubo_ring_off + kUboSliceStride > kUboRingSize)
+    m_ubo_ring_off = 0;
+  const u32 offset = m_ubo_ring_off;
+  const u32 class_index = static_cast<u32>(ubo_class);
+  if (class_index >= static_cast<u32>(UboClass::Count) ||
+      !m_ubo_compute_package.Add(
+          static_cast<UboComputeClass>(class_index), offset, data, size,
+          m_ubo_compute_shadows[class_index].data(),
+          m_ubo_compute_shadow_valid[class_index]))
+  {
+    m_cmd_stream.FailRequiredPublication();
+    return kUboOffNone;
+  }
+  std::memcpy(m_ubo_compute_shadows[class_index].data(), data, size);
+  m_ubo_compute_shadow_valid[class_index] = true;
+  m_ubo_ring_off = offset + kUboSliceStride;
+  m_last_ubo_slice_serial = ++m_ubo_publication_serial;
+  return offset;
+}
+
+bool WebGPUGfx::FlushUboComputePackage()
+{
+  if (m_ubo_compute_package.empty())
+    return true;
+  if (!m_ubo_compute_package_active || m_ubo_ring == 0)
+    return false;
+  const std::vector<u8> package = m_ubo_compute_package.Encode(m_ubo_ring);
+  if (package.empty())
+  {
+    m_cmd_stream.FailRequiredPublication();
+    return false;
+  }
+  const u32 source =
+      m_cmd_stream.UploadAlloc(package.data(), static_cast<u32>(package.size()), 256);
+  if (source == 0 ||
+      !m_cmd_stream.PushUploadBuffer(m_ubo_ring, 0, source,
+                                     static_cast<u32>(package.size()),
+                                     BufferUploadRole::UboComputePackage))
+  {
+    if (source == 0)
+      m_cmd_stream.FailRequiredPublication();
+    return false;
+  }
+  m_ubo_compute_package.Reset();
+  return true;
+}
+
+void WebGPUGfx::ResetUboComputePackageState()
+{
+  m_ubo_compute_package.Reset();
+  m_ubo_compute_shadow_valid.fill(false);
+}

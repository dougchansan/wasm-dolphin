+constexpr u32 kUboComputeCodecMagic = 0x55424350;
+constexpr u32 kUboComputeCodecVersion = 1;
+constexpr u32 kUboComputePackageAlignment = 256;
+constexpr u32 kUboComputeDiffGranularity = 16;
+constexpr u32 kUboComputeHeaderBytes = 32;
+constexpr u32 kUboComputeRecordBytes = 32;
+constexpr u32 kUboComputeRangeBytes = 8;
+constexpr u32 kUboComputeMaxRecords = 256;
+
+enum class UboComputeKind : u32
+{
+  Full = 0,
+  Delta = 1,
+  Equal = 2,
+};
+
+enum class UboComputeClass : u32
+{
+  Vertex = 0,
+  Pixel = 1,
+  Geometry = 2,
+  Count = 3,
+};
+
+struct UboComputeRange
+{
+  u32 offset = 0;
+  u32 length = 0;
+};
+
+struct UboComputeRecord
+{
+  UboComputeKind kind = UboComputeKind::Full;
+  UboComputeClass ubo_class = UboComputeClass::Vertex;
+  u32 destination_offset = 0;
+  u32 object_bytes = 0;
+  std::vector<UboComputeRange> ranges;
+  std::vector<u8> payload;
+};
+
+class UboComputePackageBuilder
+{
+public:
+  bool empty() const { return m_records.empty(); }
+  u32 size() const { return static_cast<u32>(m_records.size()); }
+  bool full() const { return m_records.size() >= kUboComputeMaxRecords; }
+  void Reset() { m_records.clear(); }
+
+  bool Add(UboComputeClass ubo_class, u32 destination_offset, const void* data, u32 size,
+           const void* previous, bool previous_valid)
+  {
+    if (full() || data == nullptr || size == 0 || (size & 15u) != 0 ||
+        (destination_offset & 3u) != 0)
+    {
+      return false;
+    }
+    const auto* const bytes = static_cast<const u8*>(data);
+    const auto* const old = static_cast<const u8*>(previous);
+    UboComputeRecord record{};
+    record.ubo_class = ubo_class;
+    record.destination_offset = destination_offset;
+    record.object_bytes = size;
+
+    if (previous_valid && old != nullptr)
+    {
+      u32 range_start = std::numeric_limits<u32>::max();
+      for (u32 offset = 0; offset < size; offset += kUboComputeDiffGranularity)
+      {
+        const bool changed =
+            std::memcmp(bytes + offset, old + offset, kUboComputeDiffGranularity) != 0;
+        if (changed && range_start == std::numeric_limits<u32>::max())
+          range_start = offset;
+        if (!changed && range_start != std::numeric_limits<u32>::max())
+        {
+          record.ranges.push_back({range_start, offset - range_start});
+          range_start = std::numeric_limits<u32>::max();
+        }
+      }
+      if (range_start != std::numeric_limits<u32>::max())
+        record.ranges.push_back({range_start, size - range_start});
+
+      if (record.ranges.empty())
+      {
+        record.kind = UboComputeKind::Equal;
+      }
+      else
+      {
+        u32 changed_bytes = 0;
+        for (const UboComputeRange& range : record.ranges)
+          changed_bytes += range.length;
+        if (changed_bytes + record.ranges.size() * kUboComputeRangeBytes < size)
+        {
+          record.kind = UboComputeKind::Delta;
+          record.payload.reserve(changed_bytes);
+          for (const UboComputeRange& range : record.ranges)
+          {
+            record.payload.insert(record.payload.end(), bytes + range.offset,
+                                  bytes + range.offset + range.length);
+          }
+        }
+        else
+        {
+          record.kind = UboComputeKind::Full;
+          record.ranges = {{0, size}};
+          record.payload.assign(bytes, bytes + size);
+        }
+      }
+    }
+    else
+    {
+      record.kind = UboComputeKind::Full;
+      record.ranges = {{0, size}};
+      record.payload.assign(bytes, bytes + size);
+    }
+    m_records.emplace_back(std::move(record));
+    return true;
+  }
+
+  std::vector<u8> Encode(u32 resource_id) const
+  {
+    if (m_records.empty() || m_records.size() > kUboComputeMaxRecords)
+      return {};
+    u32 range_bytes = 0;
+    u32 payload_bytes = 0;
+    for (const UboComputeRecord& record : m_records)
+    {
+      range_bytes += static_cast<u32>(record.ranges.size()) * kUboComputeRangeBytes;
+      payload_bytes += static_cast<u32>(record.payload.size());
+    }
+    const u32 range_start =
+        kUboComputeHeaderBytes + static_cast<u32>(m_records.size()) * kUboComputeRecordBytes;
+    const u32 payload_start = AlignDenseUbo(range_start + range_bytes, 16);
+    if (payload_start > std::numeric_limits<u32>::max() - payload_bytes)
+      return {};
+    const u32 logical_bytes = payload_start + payload_bytes;
+    const u32 package_bytes = AlignDenseUbo(logical_bytes, kUboComputePackageAlignment);
+    std::vector<u8> output(package_bytes, 0);
+    const auto put_u32 = [&output](u32 offset, u32 value) {
+      output[offset] = static_cast<u8>(value);
+      output[offset + 1] = static_cast<u8>(value >> 8);
+      output[offset + 2] = static_cast<u8>(value >> 16);
+      output[offset + 3] = static_cast<u8>(value >> 24);
+    };
+    put_u32(0, kUboComputeCodecMagic);
+    put_u32(4, kUboComputeCodecVersion);
+    put_u32(8, static_cast<u32>(m_records.size()));
+    put_u32(12, range_start);
+    put_u32(16, payload_start);
+    put_u32(20, logical_bytes);
+    put_u32(24, package_bytes);
+    put_u32(28, resource_id);
+
+    u32 next_range = range_start;
+    u32 next_payload = payload_start;
+    for (u32 index = 0; index < m_records.size(); ++index)
+    {
+      const UboComputeRecord& record = m_records[index];
+      const u32 descriptor = kUboComputeHeaderBytes + index * kUboComputeRecordBytes;
+      put_u32(descriptor, static_cast<u32>(record.kind));
+      put_u32(descriptor + 4, static_cast<u32>(record.ubo_class));
+      put_u32(descriptor + 8, record.destination_offset);
+      put_u32(descriptor + 12, record.object_bytes);
+      put_u32(descriptor + 16, static_cast<u32>(record.ranges.size()));
+      put_u32(descriptor + 20, next_range);
+      put_u32(descriptor + 24, next_payload);
+      put_u32(descriptor + 28, static_cast<u32>(record.payload.size()));
+      for (const UboComputeRange& range : record.ranges)
+      {
+        put_u32(next_range, range.offset);
+        put_u32(next_range + 4, range.length);
+        next_range += kUboComputeRangeBytes;
+      }
+      if (!record.payload.empty())
+        std::memcpy(output.data() + next_payload, record.payload.data(), record.payload.size());
+      next_payload += static_cast<u32>(record.payload.size());
+    }
+    return output;
+  }
+
+private:
+  std::vector<UboComputeRecord> m_records;
+};
 }  // namespace WebGPU

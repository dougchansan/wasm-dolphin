-{
-  // Day-30 split uses one shared sampler; per-index sampler state is a
-  // post-cutover refinement.
+void WebGPUGfx::SetSamplerState(u32 index, const SamplerState& state)
+{
+  if (index >= m_sampler_states.size())
+    return;
+  const u32 packed = PackSamplerState(state);
+  if (m_sampler_states[index] == packed)
+    return;
+  m_sampler_states[index] = packed;
+  m_sampler_ids[index] = 0;
 }
 

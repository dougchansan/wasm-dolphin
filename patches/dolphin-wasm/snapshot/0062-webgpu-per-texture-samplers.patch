+static u32 PackSamplerState(const SamplerState& state)
+{
+  // CREATE_SAMPLER keeps its one-word descriptor. Bit 31 distinguishes
+  // per-texture state from legacy untagged linear/repeat commands. Filters
+  // and wrap modes occupy bits 0..6, anisotropy 7..10, min/max LOD 11..26.
+  // LOD bias is already applied by PixelShaderGen at the texture sample.
+  return 0x80000000u | (state.tm0.hex & 0x7fu) |
+         (((state.tm0.hex >> 25) & 0xfu) << 7) | ((state.tm1.hex & 0xffffu) << 11);
+}
+
 WebGPUGfx::WebGPUGfx()
 {
+  m_sampler_states.fill(PackSamplerState(RenderState::GetPointSamplerState()));
   UpdateActiveConfig();
 }
 

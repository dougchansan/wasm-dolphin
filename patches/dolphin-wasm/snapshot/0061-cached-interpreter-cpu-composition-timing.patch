+template <bool TrackComposition, typename Function>
+decltype(auto) MeasureCompositionEvent(CompositionEvent event, Function&& function)
+{
+  if constexpr (!TrackComposition)
+  {
+    return std::forward<Function>(function)();
+  }
+  else
+  {
+    RecordCompositionEvent(event);
+    const std::uint64_t start_ns = NowNs();
+    if constexpr (std::is_void_v<std::invoke_result_t<Function>>)
+    {
+      std::forward<Function>(function)();
+      RecordCompositionElapsed(event, NowNs() - start_ns);
+      return;
+    }
+    else
+    {
+      auto result = std::forward<Function>(function)();
+      RecordCompositionElapsed(event, NowNs() - start_ns);
+      return result;
+    }
+  }
+}
+
+template <bool TrackComposition, typename Function>
+decltype(auto) MeasureCompositionEventOverlap(CompositionEvent primary_event,
+                                              CompositionEvent secondary_event,
+                                              bool secondary_active, Function&& function)
+{
+  if constexpr (!TrackComposition)
+  {
+    return std::forward<Function>(function)();
+  }
+  else
+  {
+    RecordCompositionEvent(primary_event);
+    if (secondary_active)
+      RecordCompositionEvent(secondary_event);
+    const std::uint64_t start_ns = NowNs();
+    if constexpr (std::is_void_v<std::invoke_result_t<Function>>)
+    {
+      std::forward<Function>(function)();
+      const std::uint64_t elapsed_ns = NowNs() - start_ns;
+      RecordCompositionElapsed(primary_event, elapsed_ns);
+      if (secondary_active)
+        RecordCompositionElapsed(secondary_event, elapsed_ns);
+      return;
+    }
+    else
+    {
+      auto result = std::forward<Function>(function)();
+      const std::uint64_t elapsed_ns = NowNs() - start_ns;
+      RecordCompositionElapsed(primary_event, elapsed_ns);
+      if (secondary_active)
+        RecordCompositionElapsed(secondary_event, elapsed_ns);
+      return result;
+    }
+  }
+}

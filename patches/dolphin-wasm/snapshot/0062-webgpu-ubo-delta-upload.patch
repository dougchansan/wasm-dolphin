+bool WebGPUCommandStream::PushUboDeltaUpload(u32 ring_id, u32 new_off, u32 prev_off,
+                                            u32 block_size, u32 delta_off, u32 delta_len,
+                                            u32 src_heap_ptr)
+{
+  if (ring_id == 0 || block_size == 0 || delta_len == 0)
+    return false;
+  if (!m_header)
+  {
+    PoisonPass();
+    return false;
+  }
+  CmdRecord rec{};
+  rec.op = static_cast<u32>(CmdOp::UboDeltaUpload);
+  rec.arg.u[0] = ring_id;
+  rec.arg.u[1] = new_off;
+  rec.arg.u[2] = prev_off;
+  rec.arg.u[3] = block_size;
+  rec.arg.u[4] = delta_off;
+  rec.arg.u[5] = delta_len;
+  rec.arg.u[6] = src_heap_ptr;
+  return StagePassRecord(rec);
+}

+// The changed span of `data` against `shadow`, rounded out to 256-byte blocks
+// (256 is the WebGPU dynamic-offset alignment, and rounding keeps the copy
+// destination legal). Returns false when nothing differs or when the span is
+// too large to be worth the extra records.
+static bool PlanUboDeltaSpan(const u8* data, const u8* shadow, u32 size, u32* out_off,
+                             u32* out_len)
+{
+  constexpr u32 kBlock = 256;
+  u32 lo = size;
+  u32 hi = 0;
+  for (u32 block = 0; block < size; block += kBlock)
+  {
+    const u32 span = std::min(kBlock, size - block);
+    if (std::memcmp(data + block, shadow + block, span) != 0)
+    {
+      if (block < lo)
+        lo = block;
+      hi = block + span;
+    }
+  }
+  if (lo >= hi)
+    return false;
+  // A delta only pays for itself while it is a small part of the block. Past
+  // half, the copy-forward plus the patch move more bytes than one plain
+  // upload, so fall back rather than make things worse.
+  const u32 len = hi - lo;
+  if (len * 2 >= size)
+    return false;
+  *out_off = lo;
+  *out_len = len;
+  return true;
+}
+
+u32 WebGPUGfx::AllocUboSliceDelta(const void* data, u32 size, const u8* shadow, bool shadow_valid,
+                                  u32 prev_off, BufferUploadRole role)
+{
+  const unsigned int renderer_features = DolphinWeb_GetRendererFeatureMask();
+  if ((renderer_features & DOLPHIN_WEB_RENDERER_FEATURE_UBO_DELTA) == 0 || !shadow_valid ||
+      prev_off == kUboOffNone || m_ubo_ring == 0 || size == 0 || size > kUboSliceStride)
+  {
+    return AllocUboSlice(data, size, role);
+  }
+  u32 delta_off = 0;
+  u32 delta_len = 0;
+  if (!PlanUboDeltaSpan(static_cast<const u8*>(data), shadow, size, &delta_off, &delta_len))
+    return AllocUboSlice(data, size, role);
+
+  if (m_ubo_ring_off + kUboSliceStride > kUboRingSize)
+    m_ubo_ring_off = 0;
+  const u32 off = m_ubo_ring_off;
+  // Only the changed span crosses the arena. The rest is carried forward on the
+  // device from the slice this draw's predecessor published.
+  const u32 src = m_cmd_stream.UploadAlloc(static_cast<const u8*>(data) + delta_off, delta_len, 16);
+  if (src == 0)
+  {
+    if (m_ubo_cache_active)
+      InvalidateUboSlices();
+    return kUboOffNone;
+  }
+  if (!m_cmd_stream.PushUboDeltaUpload(m_ubo_ring, off, prev_off, size, delta_off, delta_len, src))
+  {
+    if (m_ubo_cache_active)
+      InvalidateUboSlices();
+    return kUboOffNone;
+  }
+  m_ubo_ring_off = off + kUboSliceStride;
+  m_last_ubo_slice_serial = ++m_ubo_publication_serial;
+  return off;
+}

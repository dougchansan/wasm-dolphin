+// Paired-single arithmetic. ps_add/ps_sub/ps_mul measured ~5% of emulation
+// self time on Metroid Prime running through the generic interpreter path
+// (Interpreter::ps_add / ps_sub, plus Helper_Quantize for psq_st). GameCube
+// titles lean on these heavily.
+//
+// Rc==0 only: the Rc form has to UpdateCR1, which the fast path does not do.
+// SUBOP5 values are from s_table4_2 in Interpreter_Tables.cpp -- 20 ps_sub,
+// 21 ps_add, 25 ps_mul.
+static bool IsFastPairedSingleInstruction(UGeckoInstruction inst)
+{
+  if (inst.OPCD != 4 || inst.Rc)
+    return false;
+  return inst.SUBOP5 == 20 || inst.SUBOP5 == 21 || inst.SUBOP5 == 25;
+}

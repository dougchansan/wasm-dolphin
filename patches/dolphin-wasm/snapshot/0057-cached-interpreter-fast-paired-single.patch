+s32 CachedInterpreter::FastPairedSingle(PowerPC::PowerPCState& ppc_state,
+                                        const FastInstructionOperands& operands)
+{
+  const auto& [power_pc, current_pc, inst] = operands;
+  if (!FastCheckFpuAvailable(ppc_state, power_pc, current_pc))
+  {
+    ppc_state.pc = current_pc;
+    power_pc.CheckExceptions();
+    return 0;
+  }
+
+  // ps_sub(20) / ps_add(21) / ps_mul(25), Rc==0 only. Mirrors
+  // Interpreter::ps_sub/ps_add/ps_mul exactly, including ps_mul's Force25Bit on
+  // the FC operand, but takes plain double arithmetic when the FPSCR invalid
+  // enable is clear and all four operands are finite -- the same shape as
+  // FastFloat's fadds/fsubs path. Anything else goes through NI_* unchanged.
+  const bool is_mul = inst.SUBOP5 == 25;
+  const bool is_add = inst.SUBOP5 == 21;
+  const auto& a = ppc_state.ps[inst.FA];
+  const auto& b = is_mul ? ppc_state.ps[inst.FC] : ppc_state.ps[inst.FB];
+
+  const double a0 = a.PS0AsDouble();
+  const double a1 = a.PS1AsDouble();
+  double b0 = b.PS0AsDouble();
+  double b1 = b.PS1AsDouble();
+  if (is_mul)
+  {
+    b0 = Force25Bit(b0);
+    b1 = Force25Bit(b1);
+  }
+
+  float ps0;
+  float ps1;
+  if (ppc_state.fpscr.VE == 0 && IsFiniteFastFloatOperand(a.PS0AsU64()) &&
+      IsFiniteFastFloatOperand(a.PS1AsU64()) && IsFiniteFastFloatOperand(b.PS0AsU64()) &&
+      IsFiniteFastFloatOperand(b.PS1AsU64()))
+  {
+    const double r0 = is_mul ? a0 * b0 : (is_add ? a0 + b0 : a0 - b0);
+    const double r1 = is_mul ? a1 * b1 : (is_add ? a1 + b1 : a1 - b1);
+    ps0 = ForceSingle(ppc_state.fpscr, r0);
+    ps1 = ForceSingle(ppc_state.fpscr, r1);
+  }
+  else
+  {
+    const FPResult r0 = is_mul ? NI_mul(ppc_state, a0, b0) :
+                                 (is_add ? NI_add(ppc_state, a0, b0) : NI_sub(ppc_state, a0, b0));
+    const FPResult r1 = is_mul ? NI_mul(ppc_state, a1, b1) :
+                                 (is_add ? NI_add(ppc_state, a1, b1) : NI_sub(ppc_state, a1, b1));
+    ps0 = ForceSingle(ppc_state.fpscr, r0.value);
+    ps1 = ForceSingle(ppc_state.fpscr, r1.value);
+  }
+
+  ppc_state.ps[inst.FD].SetBoth(ps0, ps1);
+  ppc_state.UpdateFPRFSingle(ps0);
+
+  return sizeof(AnyCallback) + sizeof(operands);
 }
 

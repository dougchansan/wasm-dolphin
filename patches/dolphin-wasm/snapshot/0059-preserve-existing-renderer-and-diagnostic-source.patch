+bool WebGPUCommandStream::PushClearRect(u32 x, u32 y, u32 w, u32 h, u32 rgba, float depth,
+                                        u32 flags)
+{
+  if (w == 0 || h == 0 || flags == 0)
+    return true;
+  if (!m_header)
+  {
+    PoisonPass();
+    return false;
+  }
+  CmdRecord rec{};
+  rec.op = static_cast<u32>(CmdOp::ClearRect);
+  rec.arg.u[0] = x;
+  rec.arg.u[1] = y;
+  rec.arg.u[2] = w;
+  rec.arg.u[3] = h;
+  rec.arg.u[4] = rgba;
+  rec.arg.f[5] = depth;
+  rec.arg.u[6] = flags;
+  return StagePassRecord(rec);
+}

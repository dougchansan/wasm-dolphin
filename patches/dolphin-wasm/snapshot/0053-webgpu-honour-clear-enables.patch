+
+// Clear intent, packed into the existing 32-bit load_op word of BEGIN_PASS.
+// bit0 keeps its original meaning (clear vs load) so an older consumer still
+// reads a correct clear/no-clear decision; bits 1 and 2 carry which
+// attachments the game actually asked to clear. No record widening needed --
+// the word already had 31 spare bits.
+u32 WebGPUGfx::PendingClearMask() const
+{
+  if (!m_pending_clear)
+    return 0u;
+  u32 mask = 1u;
+  if (m_pending_clear_color)
+    mask |= 2u;
+  if (m_pending_clear_depth)
+    mask |= 4u;
+  return mask;
+}

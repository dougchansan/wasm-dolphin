+}
+
+static u32 Pack16(u32 lo, u32 hi)
+{
+  return (lo & 0xFFFFu) | ((hi & 0xFFFFu) << 16);
+}
+
+void WebGPUCommandStream::PushBlitTexture(u32 src_id, u32 dst_id, u32 src_x, u32 src_y,
+                                          u32 src_w, u32 src_h, u32 dst_x, u32 dst_y,
+                                          u32 dst_w, u32 dst_h, u32 src_layer, u32 src_level,
+                                          u32 dst_layer, u32 dst_level)
+{
+  if (!m_header || src_id == 0 || dst_id == 0 || src_w == 0 || src_h == 0 || dst_w == 0 ||
+      dst_h == 0)
+    return;
+  CmdRecord rec{};
+  rec.op = static_cast<u32>(CmdOp::BlitTexture);
+  rec.arg.u[0] = src_id;
+  rec.arg.u[1] = dst_id;
+  rec.arg.u[2] = Pack16(src_x, src_y);
+  rec.arg.u[3] = Pack16(src_w, src_h);
+  rec.arg.u[4] = Pack16(dst_x, dst_y);
+  rec.arg.u[5] = Pack16(dst_w, dst_h);
+  rec.arg.u[6] = (src_layer & 0xFFu) | ((src_level & 0xFFu) << 8) |
+                 ((dst_layer & 0xFFu) << 16) | ((dst_level & 0xFFu) << 24);
+  Push(rec);
+}
+
+WebGPUCommandStream& GetCommandStream()
+{
+  static WebGPUCommandStream s_stream;
+  return s_stream;
+}
+}  // namespace WebGPU

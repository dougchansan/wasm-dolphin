+// Copyright 2026 Dolphin Emulator Project (wasm-dolphin fork)
+// SPDX-License-Identifier: GPL-2.0-or-later
+
+#include "VideoBackends/WebGPU/WebGPUCommandStream.h"
+
+#include <cstdint>
+#include <cstdlib>
+#include <cstring>
+#include <new>
+
+#include <emscripten/emscripten.h>
+
+namespace WebGPU
+{
+// Ring capacity. A complex Melee frame is hundreds of GX draws, each
+// ~SET_PIPELINE + 3×SET_BIND_GROUP + 2×SET_*_BUFFER + DRAW_INDEXED +
+// CREATE_BIND_GROUP + UBO upload — easily a few thousand records — and
+// the consumer (event-loop driven) runs 1-2 frames behind, so multiple
+// frames' records are in flight at once. 4096 overflowed under load:
+// Push() then silently dropped CREATE_TEXTURE/CREATE_BIND_GROUP
+// records, so those resources never existed on the consumer and every
+// later SET_BIND_GROUP/SET_PIPELINE for them missed permanently
+// (missBg/missPipe grew with scene complexity → geometry never
+// landed). 64K records = 2 MB — trivial — gives many frames of slack.
+// §28o: 65536 (2 MB @32 B/rec) overflowed under transition load
+// spikes → 1 backpressure DROP/75 s → a permanently-lost record →
+// a black-flash frame (user: "flashy/glitchy"). 4× (8 MB) absorbs
+// the spike; the consumer drains in µs so the ring never sits full
+// in steady state. Worker reads `capacity` from the hand-off message
+// (no consumer-side constant), so this propagates automatically.
+static constexpr u32 kRingCapacity = 262144;
+
+// Per-frame upload arena. Dolphin's vertex/index/uniform streaming
+// for a Melee menu frame is a few hundred KB; 32 MB gives the
+// consumer (1-2 frames behind) ~tens of frames of recycle headroom
+// before the bump pointer wraps back over a region it might still be
+// reading. Mirrors the Day-20 XFB-ring idea (no per-frame malloc).
+static constexpr u32 kUploadArenaBytes = 32u * 1024u * 1024u;
+
+void WebGPUCommandStream::EnsureRing()
+{
+  if (m_header)
+    return;
+
+  const size_t bytes = sizeof(CmdRingHeader) + sizeof(CmdRecord) * kRingCapacity;
+  void* block = std::malloc(bytes);
+  if (!block)
+    return;
+  std::memset(block, 0, bytes);
+
+  m_header = new (block) CmdRingHeader();
+  m_header->write.store(0, std::memory_order_relaxed);
+  m_header->read.store(0, std::memory_order_relaxed);
+  m_header->capacity = kRingCapacity;
+  m_header->reserved = 0;
+  m_slots = reinterpret_cast<CmdRecord*>(static_cast<u8*>(block) + sizeof(CmdRingHeader));
+  m_capacity = kRingCapacity;
+
+  // Per-frame upload arena (DESIGN §payload). Allocated once, never
+  // freed; the producer bump-allocates into it and the consumer
+  // reads straight from the shared heap (zero-copy).
+  m_upload_base = static_cast<u8*>(std::malloc(kUploadArenaBytes));
+  m_upload_size = m_upload_base ? kUploadArenaBytes : 0;
+  m_upload_head = 0;
+
+  // Hand the ring + upload arena to the discio worker. The wasm heap
+  // is a SharedArrayBuffer (USE_PTHREADS), so passing pointers is
+  // enough — the worker reads header+slots+uploads in place, no copy.
+  // Same postMessage style as the Day-19 ShowImage hand-off.
+  EM_ASM(
+      {
+        if (typeof self !== 'undefined' && self.postMessage)
+          self.postMessage({ type : 'webgpu-cmd-ring', headerPtr : $0,
+                              slotsPtr : $1, capacity : $2, uploadPtr : $3,
+                              uploadSize : $4 });
+      },
+      reinterpret_cast<intptr_t>(m_header), reinterpret_cast<intptr_t>(m_slots),
+      static_cast<int>(m_capacity), reinterpret_cast<intptr_t>(m_upload_base),
+      static_cast<int>(m_upload_size));
+}
+
+bool WebGPUCommandStream::Push(const CmdRecord& rec)
+{
+  if (!m_header)
+    return false;
+
+  const u32 w = m_header->write.load(std::memory_order_relaxed);
+  if (w - m_header->read.load(std::memory_order_acquire) >= m_capacity)
+  {
+    // Ring full — the consumer (discio worker, a SEPARATE thread that
+    // drains continuously) is behind. The Day-27 policy was "drop
+    // rather than stall the video pthread", but a dropped record is
+    // never a safe loss here: losing a CREATE_* permanently removes a
+    // resource the consumer needs forever (every later SET_BIND_GROUP/
+    // SET_PIPELINE referencing it misses → missBg/missPipe ratchet up,
+    // geometry never lands — exactly the texture-burst regression).
+    //
+    // Apply bounded backpressure instead: spin reading the consumer's
+    // read index (it's advancing on its own thread, so space frees in
+    // microseconds) until the slot is free. This paces the producer to
+    // the consumer's rate — a transient frame-time hitch under a load
+    // spike, not permanent state corruption. Correctness first;
+    // smoothness is the later (task-8) pass. A generous cap avoids a
+    // hard hang if the consumer ever truly dies (then, and only then,
+    // fall back to the old drop).
+    // Small cap on purpose: the consumer drain shares the discio
+    // worker JS thread with api.runFrame(); if runFrame is the thing
+    // blocked behind the GPU FIFO, the consumer can't drain and a long
+    // spin would freeze emulation. When backpressure actually helps
+    // (consumer draining on its loop), space frees within a few
+    // iterations; when it would deadlock, bail fast and degrade to the
+    // old drop so emulation keeps progressing instead of hanging.
+    u32 spins = 0;
+    constexpr u32 kMaxSpins = 500000u;
+    while (w - m_header->read.load(std::memory_order_acquire) >= m_capacity)
+    {
+      if (++spins >= kMaxSpins)
+      {
+        ++m_dropped;
+        if (m_dropped == 1 || (m_dropped % 10000) == 0)
+        {
+          EM_ASM(
+              {
+                if (typeof console !== 'undefined')
+                  console.log('[webgpu-ring] DROPPED ' + $0 +
+                              ' records (consumer stuck — backpressure timed out)');
+              },
+              static_cast<int>(m_dropped));
+        }
+        return false;
+      }
+    }
+  }
+
+  m_slots[w % m_capacity] = rec;
+  // Release: the slot write above must be visible to the consumer
+  // before it observes the bumped write index.
+  m_header->write.store(w + 1, std::memory_order_release);
+  return true;
+}
+
+void WebGPUCommandStream::PushClear(float r, float g, float b, float a)
+{
+  CmdRecord rec{};
+  rec.op = static_cast<u32>(CmdOp::Clear);
+  rec.arg.f[0] = r;
+  rec.arg.f[1] = g;
+  rec.arg.f[2] = b;
+  rec.arg.f[3] = a;
+  Push(rec);
+}
+
+u32 WebGPUCommandStream::PushCreateShader(const char* wgsl, size_t len, u32 stage)
+{
+  if (!m_header || !wgsl || len == 0)
+    return 0;
+
+  // Persistent blob in the shared wasm heap. The consumer copies the
+  // WGSL into a JS string at replay (small, bounded — Dolphin caches
+  // shaders), so a never-freed pool is acceptable.
+  void* blob = std::malloc(len);
+  if (!blob)
+    return 0;
+  std::memcpy(blob, wgsl, len);
+
+  const u32 id = m_next_id++;
+  CmdRecord rec{};
+  rec.op = static_cast<u32>(CmdOp::CreateShader);
+  rec.arg.u[0] = id;
+  rec.arg.u[1] = static_cast<u32>(reinterpret_cast<uintptr_t>(blob));
+  rec.arg.u[2] = static_cast<u32>(len);
+  rec.arg.u[3] = stage;
+  if (!Push(rec))
+  {
+    std::free(blob);
+    return 0;
+  }
+  return id;
+}
+
+u32 WebGPUCommandStream::PushCreatePipeline(u32 vs_shader_id, u32 fs_shader_id, u32 topology)
+{
+  if (!m_header || vs_shader_id == 0 || fs_shader_id == 0)
+    return 0;
+  const u32 id = m_next_id++;
+  CmdRecord rec{};
+  rec.op = static_cast<u32>(CmdOp::CreatePipeline);
+  rec.arg.u[0] = id;
+  rec.arg.u[1] = vs_shader_id;
+  rec.arg.u[2] = fs_shader_id;
+  rec.arg.u[3] = topology;
+  if (!Push(rec))
+    return 0;
+  return id;
+}
+
+void WebGPUCommandStream::PushDrawTest(u32 pipeline_id, u32 vertex_count)
+{
+  if (!m_header || pipeline_id == 0)
+    return;
+  CmdRecord rec{};
+  rec.op = static_cast<u32>(CmdOp::DrawTest);
+  rec.arg.u[0] = pipeline_id;
+  rec.arg.u[1] = vertex_count;
+  Push(rec);
+}
+
+// ---- Phase A producer API ----------------------------------------
+
+u32 WebGPUCommandStream::UploadAlloc(const void* data, size_t len, u32 align)
+{
+  if (!m_upload_base || m_upload_size == 0 || len == 0 || len > m_upload_size)
+    return 0;
+  if (align < 4)
+    align = 4;
+  u32 head = (m_upload_head + (align - 1)) & ~(align - 1);
+  if (head + len > m_upload_size)
+    head = 0;  // wrap (recycle — sized so the consumer is long past)
+  std::memcpy(m_upload_base + head, data, len);
+  m_upload_head = head + static_cast<u32>(len);
+  return static_cast<u32>(reinterpret_cast<uintptr_t>(m_upload_base + head));
+}
+
+u32 WebGPUCommandStream::PushCreateBuffer(u32 size, u32 usage_flags)
+{
+  if (!m_header)
+    return 0;

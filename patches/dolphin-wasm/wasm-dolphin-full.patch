+// Copyright 2026 Dolphin Emulator Project (wasm-dolphin fork)
+// SPDX-License-Identifier: GPL-2.0-or-later
+
+#pragma once
+
+#include "VideoCommon/VideoBackendBase.h"
+
+// Forward declaration of the emdawnwebgpu C handle. We deliberately do
+// not #include <webgpu/webgpu.h> from this public header so that other
+// translation units (e.g. VideoBackendBase.cpp in videocommon) which
+// include this header don't need the WebGPU port on their include path.
+// The .cpp side does the real include.
+struct WGPUDeviceImpl;
+using WGPUDevice = WGPUDeviceImpl*;
+
+namespace WebGPU
+{
+// Day 14: scaffold-only. The backend itself is structured like Null —
+// the AbstractGfx implementation will gain real WebGPU API calls in
+// Day 15+. For now Initialize() succeeds, lifecycle works, and we have
+// a place to plug WGSL pipelines and command-buffer machinery without
+// disrupting the OGL / Software / Null backends that ship today.
+class VideoBackend final : public VideoBackendBase
+{
+public:
+  bool Initialize(const WindowSystemInfo& wsi) override;
+  void Shutdown() override;
+
+  std::string GetConfigName() const override { return CONFIG_NAME; }
+  std::string GetDisplayName() const override;
+  void InitBackendInfo(const WindowSystemInfo& wsi) override;
+
+  static constexpr const char* CONFIG_NAME = "WebGPU";
+
+private:
+  // Day-15: device handle acquired from JS via
+  // emscripten_webgpu_get_device(). Null if the JS bootstrap didn't
+  // hand us a preinitializedWebGPUDevice — backend stays in stub mode.
+  WGPUDevice m_device = nullptr;
+};
+}  // namespace WebGPU

--- /dev/null
+++ b/Source/Core/VideoBackends/WebGPU/WebGPUVertexManager.h
@@ -0,0 +1,67 @@
+// Copyright 2026 Dolphin Emulator Project (wasm-dolphin fork)
+// SPDX-License-Identifier: GPL-2.0-or-later
+
+#pragma once
+
+#include "Common/CommonTypes.h"
+#include "VideoCommon/VertexManagerBase.h"
+
+namespace WebGPU
+{
+// Day-33 A3: a real VertexManagerBase for the remote WebGPU backend.
+//
+// Vertices/indices are assembled by VideoCommon into the base class's
+// CPU staging buffers (m_cpu_vertex_buffer / m_cpu_index_buffer — the
+// default ResetBuffer points the write cursor there). On CommitBuffer
+// we copy the just-written bytes into the cross-thread upload arena
+// and emit UPLOAD_BUFFER into two persistent GPU buffers (created
+// once); DrawCurrentBatch records SET_VERTEX_BUFFER / SET_INDEX_BUFFER
+// / DRAW_INDEXED. The discio worker replays it on the real device.
+// Pipeline + render pass + bind groups are recorded by the WebGPUGfx
+// AbstractGfx overrides; this only owns vertex/index data + the draw.
+class VertexManager final : public VertexManagerBase
+{
+public:
+  VertexManager();
+  ~VertexManager() override;
+
+  bool Initialize() override;
+
+  // EFB-copy / texture-conversion / present shaders push their PSBlock
+  // params here. Forwarded to WebGPUGfx, which binds them at group0
+  // binding0 for the utility draw (§15 textured-black root cause: this
+  // was the empty base no-op, so those shaders ran with garbage
+  // uniforms and produced opaque-black EFB-copy textures).
+  void UploadUtilityUniforms(const void* uniforms, u32 uniforms_size) override;
+
+  // Persistent GPU buffer bridge ids (0 until the ring is live). Read
+  // by WebGPUGfx::DrawIndexed, which centralises draw recording (it
+  // also owns pipeline/framebuffer/texture/UBO state). Draw recording
+  // therefore goes through the base DrawCurrentBatch → g_gfx->
+  // DrawIndexed path rather than being overridden here.
+  u32 GetVertexBufferId() const { return m_vertex_buffer_id; }
+  u32 GetIndexBufferId() const { return m_index_buffer_id; }
+
+protected:
+  void CommitBuffer(u32 num_vertices, u32 vertex_stride, u32 num_indices, u32* out_base_vertex,
+                    u32* out_base_index) override;
+
+private:
+  void EnsureBuffers();
+
+  // Persistent GPU buffers (bridge ids; 0 until created). Large
+  // ring-rolled regions — the consumer is ~1 frame behind and a
+  // frame's geometry is far smaller, so wrapping never overwrites a
+  // region still being read (same reasoning as the upload arena).
+  u32 m_vertex_buffer_id = 0;
+  u32 m_index_buffer_id = 0;
+  static constexpr u32 kVertexBufferSize = 16u * 1024u * 1024u;
+  static constexpr u32 kIndexBufferSize = 4u * 1024u * 1024u;
+  u32 m_vertex_offset = 0;  // rolling byte offset into the GPU vbuf
+  u32 m_index_offset = 0;   // rolling byte offset into the GPU ibuf
+
+  // Last committed batch placement (consumed by DrawCurrentBatch).
+  u32 m_last_vertex_byte = 0;
+  u32 m_last_index_byte = 0;
+};
+}  // namespace WebGPU

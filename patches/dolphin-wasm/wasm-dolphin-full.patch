+
+u32 WebGPUGfx::AllocUboSlice(const void* data, u32 size)
+{
+  if (m_ubo_ring == 0 || size == 0 || size > kUboSliceStride)
+    return kUboOffNone;
+  // Bump-allocate a fixed-stride slice (stride is 256-aligned so the
+  // offset is a valid WebGPU dynamic offset). Wrap at ring end; the
+  // ring spans many frames of distinct constant sets so the consumer
+  // (≤2 frames behind) never reads a recycled slice.
+  if (m_ubo_ring_off + kUboSliceStride > kUboRingSize)
+    m_ubo_ring_off = 0;
+  const u32 off = m_ubo_ring_off;
+  const u32 src = m_cmd_stream.UploadAlloc(data, size, 16);
+  if (src == 0)
+    return kUboOffNone;
+  m_cmd_stream.PushUploadBuffer(m_ubo_ring, off, src, size);
+  m_ubo_ring_off = off + kUboSliceStride;
+  return off;
+}
+
+void WebGPUGfx::UploadUtilityUniforms(const void* data, u32 size)
+{
+  if (data == nullptr || size == 0)
+    return;
+  const u32 off = AllocUboSlice(data, size);
+  if (off == kUboOffNone)
+    return;
+  // The next recorded draw is a utility draw — group0/binding0's
+  // dynamic offset selects this util slice (the EFB-copy / conversion
+  // PSBlock) instead of the GX PixelShaderConstants slice. Cleared by
+  // Draw/DrawIndexed so the following GX draw reverts.
+  m_util_off = off;
+  m_util_uniform_mode = true;
+#ifdef __EMSCRIPTEN__
+  // §28ac decisive probe (ii): what did TextureCacheBase actually write
+  // into the util slice? size==48 ⇒ the EFB→texture copy Uniforms
+  // (TextureCacheBase.cpp:2870): 4 src floats, then filter_coefficients
+  // (vec3<u32> @byte16 = §28z member_2 COLSCALE), gamma_rcp@28,
+  // clamp@32/36, pixel_height@40. member_2[1] (@byte20) must be ≈64
+  // for a faithful copy (§28z out = efbTexel·255·member_2[1]/64).
+  {
+    static u32 s_uu = 0;
+    const u32 n = s_uu++;
+    if (n < 8 || (n % 120) == 0)
+    {
+      const auto p = reinterpret_cast<intptr_t>(data);
+      EM_ASM(
+          {
+            console.log('[s28ac-uu] n=' + $3 + ' t=' +
+              performance.now().toFixed(0) + ' sz=' + $0 +
+              ' utilOff=' + $1 +
+              (($0 >= 44) ?
+                (' fc=' + HEAPU32[($2>>2)+4] + ',' + HEAPU32[($2>>2)+5] +
+                 ',' + HEAPU32[($2>>2)+6] +
+                 ' srcRect=' + HEAPF32[($2>>2)+0].toFixed(4) + ',' +
+                   HEAPF32[($2>>2)+1].toFixed(4) + ',' +
+                   HEAPF32[($2>>2)+2].toFixed(4) + ',' +
+                   HEAPF32[($2>>2)+3].toFixed(4) +
+                 ' gammaRcp=' + HEAPF32[($2>>2)+7].toFixed(4) +
+                 ' clamp=' + HEAPF32[($2>>2)+8].toFixed(4) + ',' +
+                   HEAPF32[($2>>2)+9].toFixed(4) +
+                 ' pxH=' + HEAPF32[($2>>2)+10].toFixed(6)) : ''));
+          },
+          size, off, p, n);
+    }
+  }
+#endif
+}
+
+void WebGPUGfx::Draw(u32 base_vertex, u32 num_vertices)
+{
+  if (m_cur_pipeline_id == 0)
+  {
+    // Don't let an armed utility-uniform mode leak onto a later GX draw
+    // when this (utility) draw is skipped.
+    m_util_uniform_mode = false;
+    return;
+  }
+  BeginPassIfNeeded();
+  if (m_last_set_pipeline_id != m_cur_pipeline_id)
+  {
+    m_cmd_stream.PushSetPipeline(m_cur_pipeline_id);
+    m_last_set_pipeline_id = m_cur_pipeline_id;
+  }
+  PrepareDrawResources();
+  const auto* vm = static_cast<const VertexManager*>(g_vertex_manager.get());
+  if (vm && vm->GetVertexBufferId())
+    m_cmd_stream.PushSetVertexBuffer(0, vm->GetVertexBufferId(), 0);
+  m_cmd_stream.PushDraw(num_vertices, 1, base_vertex);
+  // Utility draw consumed — revert to the GX bg0 for following draws.
+  m_util_uniform_mode = false;
+}
+
+void WebGPUGfx::DrawIndexed(u32 base_index, u32 num_indices, u32 base_vertex)
+{
+  if (m_cur_pipeline_id == 0 || num_indices == 0)
+  {
+    m_util_uniform_mode = false;
+    return;
+  }
+  BeginPassIfNeeded();
+  if (m_last_set_pipeline_id != m_cur_pipeline_id)
+  {
+    m_cmd_stream.PushSetPipeline(m_cur_pipeline_id);
+    m_last_set_pipeline_id = m_cur_pipeline_id;
+  }
+  PrepareDrawResources();
+  const auto* vm = static_cast<const VertexManager*>(g_vertex_manager.get());
+  if (!vm || vm->GetVertexBufferId() == 0 || vm->GetIndexBufferId() == 0)
+  {
+    m_util_uniform_mode = false;
+    return;
+  }
+  m_cmd_stream.PushSetVertexBuffer(0, vm->GetVertexBufferId(), 0);
+  m_cmd_stream.PushSetIndexBuffer(vm->GetIndexBufferId(), /*u16=*/0, 0);
+  m_cmd_stream.PushDrawIndexed(num_indices, 1, base_index, base_vertex);
+  // Utility draw consumed — revert to the GX bg0 for following draws.
+  m_util_uniform_mode = false;
+}
+
+void WebGPUGfx::ScaleTexture(AbstractFramebuffer* dst_framebuffer,
+                             const MathUtil::Rectangle<int>& dst_rect,
+                             const AbstractTexture* src_texture,
+                             const MathUtil::Rectangle<int>& src_rect)
+{
+  // Reuse Software's CPU CopyRegion path. We just need to forward the
+  // call through to where SWGfx::ScaleTexture lives (its
+  // implementation is in SWTexture.cpp). Casts mirror SWGfx exactly.
+  AbstractGfx::ScaleTexture(dst_framebuffer, dst_rect, src_texture, src_rect);
+}
+
+SurfaceInfo WebGPUGfx::GetSurfaceInfo() const
+{
+  // Day-33 Phase C: the backbuffer is the real WebGPU canvas, whose
+  // format is navigator.gpu.getPreferredCanvasFormat() — bgra8unorm
+  // on Chrome/desktop. VideoCommon builds the XFB→backbuffer blit
+  // pipeline from this format; reporting RGBA8 made that pipeline
+  // incompatible with the bgra8unorm canvas pass ("Attachment state
+  // ... not compatible"), so the blit silently failed and nothing
+  // presented. Must match the consumer's context format.
+  return {640, 480, 1.0f, AbstractTextureFormat::BGRA8};
+}
+
+void WebGPUEFBInterface::ReinterpretPixelData(EFBReinterpretType /* convtype */)
+{
+}
+
+void WebGPUEFBInterface::PokeColor(u16 /* x */, u16 /* y */, u32 /* color */)
+{
+}
+
+void WebGPUEFBInterface::PokeDepth(u16 /* x */, u16 /* y */, u32 /* depth */)
+{
+}
+
+u32 WebGPUEFBInterface::PeekColorInternal(u16 /* x */, u16 /* y */)
+{
+  return 0;
+}
+
+u32 WebGPUEFBInterface::PeekDepthInternal(u16 /* x */, u16 /* y */)
+{
+  return 0;
+}
+
+}  // namespace WebGPU
diff --git a/Source/Core/VideoBackends/WebGPU/WebGPUGfx.h b/Source/Core/VideoBackends/WebGPU/WebGPUGfx.h
new file mode 100644
index 0000000..0c98aff
--- /dev/null
+++ b/Source/Core/VideoBackends/WebGPU/WebGPUGfx.h
@@ -0,0 +1,282 @@
+// Copyright 2026 Dolphin Emulator Project (wasm-dolphin fork)
+// SPDX-License-Identifier: GPL-2.0-or-later
+
+#pragma once
+
+#include <array>
+#include <vector>
+
+#include "Common/CommonTypes.h"
+
+#include "VideoBackends/WebGPU/WebGPUCommandStream.h"
+
+#include "VideoCommon/AbstractGfx.h"
+#include "VideoCommon/EFBInterface.h"
+
+// Forward-declare the emdawnwebgpu device handle (same pattern as
+// VideoBackend.h) so this public header doesn't drag <webgpu/webgpu.h>
+// onto every TU that includes it.
+struct WGPUDeviceImpl;
+using WGPUDevice = WGPUDeviceImpl*;
+
+namespace WebGPU
+{
+// Day-18: WebGPUGfx delegates everything-but-presentation to Software's
+// rasteriser (SWTexture, SWFramebuffer, SWVertexLoader, Clipper,
+// Rasterizer, SWPixelEngine — initialised in WebGPU::VideoBackend::
+// Initialize). CPU rasterisation writes pixels into the same SWTexture
+// storage SoftwareBackend uses; we override ShowImage to route those
+// pixels through a real `wgpuRenderPass` on the canvas instead of the
+// SWOGLWindow GL path. Day-19+ replaces individual pieces (clear,
+// blit, EFB copy) with real GPU operations until SW gradually drops
+// out of the chain.
+class WebGPUGfx final : public AbstractGfx
+{
+public:
+  // Day-26: WebGPUGfx owns device acquisition. VideoBackend::Initialize
+  // kicks an async navigator.gpu request on this video pthread;
+  // EnsureDevice() (called per-frame from the hot paths) polls and
+  // imports the device into this thread's emdawnwebgpu table once it
+  // resolves. m_device is null until then — Software path renders
+  // meanwhile (Day-18 fallback).
+  WebGPUGfx();
+  ~WebGPUGfx() override;
+
+  bool IsHeadless() const override;
+  bool SupportsUtilityDrawing() const override;
+
+  // Day-33 §15: utility / EFB-copy pixel shaders read their parameters
+  // from `UBO_BINDING(std140, 1) uniform PSBlock` (→ WGSL group0
+  // binding0). Dolphin pushes those bytes through
+  // g_vertex_manager->UploadUtilityUniforms, which the WebGPU
+  // VertexManager forwards here. Without this the EFB-copy shader
+  // transforms the (correct) EFB with a garbage colmat → opaque-black
+  // EFB-copy textures → every textured draw that samples them is black.
+  void UploadUtilityUniforms(const void* data, u32 size);
+
+  std::unique_ptr<AbstractTexture> CreateTexture(const TextureConfig& config,
+                                                 std::string_view name) override;
+  std::unique_ptr<AbstractStagingTexture>
+  CreateStagingTexture(StagingTextureType type, const TextureConfig& config) override;
+  std::unique_ptr<AbstractFramebuffer>
+  CreateFramebuffer(AbstractTexture* color_attachment, AbstractTexture* depth_attachment,
+                    std::vector<AbstractTexture*> additional_color_attachments) override;
+
+  std::unique_ptr<AbstractShader>
+  CreateShaderFromSource(ShaderStage stage, std::string_view source,
+                         VideoCommon::ShaderIncluder* shader_includer,
+                         std::string_view name) override;
+  std::unique_ptr<AbstractShader> CreateShaderFromBinary(ShaderStage stage, const void* data,
+                                                         size_t length,
+                                                         std::string_view name) override;
+  std::unique_ptr<NativeVertexFormat>
+  CreateNativeVertexFormat(const PortableVertexDeclaration& vtx_decl) override;
+  std::unique_ptr<AbstractPipeline> CreatePipeline(const AbstractPipelineConfig& config,
+                                                   const void* cache_data = nullptr,
+                                                   size_t cache_data_length = 0) override;
+  SurfaceInfo GetSurfaceInfo() const override;
+
+  bool BindBackbuffer(const ClearColor& clear_color = {}) override;
+  void PresentBackbuffer() override;
+  void ShowImage(const AbstractTexture* source_texture,
+                 const MathUtil::Rectangle<int>& source_rc) override;
+  void ClearRegion(const MathUtil::Rectangle<int>& target_rc, bool colorEnable, bool alphaEnable,
+                   bool zEnable, u32 color, u32 z) override;
+  void SetScissorRect(const MathUtil::Rectangle<int>& rc) override;
+
+  // Day-33 A3/A4/A5: real AbstractGfx draw/state recording. Active
+  // once SupportsUtilityDrawing() is flipped true (Phase C); until
+  // then VideoCommon takes the ShowImage(xfb) SW-hybrid fallback and
+  // these are never called.
+  void SetPipeline(const AbstractPipeline* pipeline) override;
+  void SetFramebuffer(AbstractFramebuffer* framebuffer) override;
+  void SetAndDiscardFramebuffer(AbstractFramebuffer* framebuffer) override;
+  void SetAndClearFramebuffer(AbstractFramebuffer* framebuffer, const ClearColor& color_value,
+                              float depth_value) override;
+  void SetViewport(float x, float y, float width, float height, float near_depth,
+                   float far_depth) override;
+  void SetTexture(u32 index, const AbstractTexture* texture) override;
+  void SetSamplerState(u32 index, const SamplerState& state) override;
+  void Draw(u32 base_vertex, u32 num_vertices) override;
+  void DrawIndexed(u32 base_index, u32 num_indices, u32 base_vertex) override;
+  void ScaleTexture(AbstractFramebuffer* dst_framebuffer,
+                    const MathUtil::Rectangle<int>& dst_rect,
+                    const AbstractTexture* src_texture,
+                    const MathUtil::Rectangle<int>& src_rect) override;
+
+private:
+  float m_clear_r = 0.05f;
+  float m_clear_g = 0.10f;
+  float m_clear_b = 0.30f;
+  // Set once VideoCommon's Presenter has handed us its first XFB.
+  // After that PresentBackbuffer suppresses the clear pass so it
+  // doesn't paint over the real frame the discio worker just blitted.
+  bool m_show_image_seen = false;
+
+  // Day-20: ring of XFB snapshots. ShowImage memcpys the CPU
+  // rasteriser's just-finished frame into the next slot and posts that
+  // slot's pointer to the discio worker. Cycling through kXfbRingSize
+  // slots means we don't overwrite a buffer until kXfbRingSize frames
+  // later, by which point the worker has long since blitted it — no
+  // tear race, while avoiding the Day-18 JS slice + structured-clone.
+  static constexpr int kXfbRingSize = 4;
+  struct XfbRingSlot
+  {
+    std::vector<u8> pixels;
+  };
+  std::array<XfbRingSlot, kXfbRingSize> m_xfb_ring;
+  int m_xfb_ring_index = 0;
+
+  // Day-26: poll `self.__dolphinPthreadWgpuStatus`; once 'ready',
+  // import the pthread-owned device into this thread's emdawnwebgpu
+  // table and cache it in m_device. Cheap no-op once acquired/failed.
+  void EnsureDevice();
+
+  // Day-24/26: real WebGPU device, acquired on THIS video pthread
+  // (Day-26). Null until the async request resolves ⇒ Software path.
+  WGPUDevice m_device = nullptr;
+  // 0 = still polling, 1 = acquired, -1 = unavailable/failed (stop
+  // polling and stay on Software permanently).
+  int m_device_state = 0;
+
+  // Day-27: cross-thread command ring. PresentBackbuffer records into
+  // it; the discio worker replays on its device. The real GPU render
+  // path is built by widening the opcode set this records.
+  // Day-33 A3: shared with WebGPU::VertexManager (both produce into
+  // the one ring; single-producer on the video pthread).
+  WebGPUCommandStream& m_cmd_stream = GetCommandStream();
+
+  // Day-29 pipeline-replay proof: first translatable vertex-shader
+  // bridge id, and the test pipeline built from it (both one-shot).
+  u32 m_test_vs_id = 0;
+  u32 m_test_fs_id = 0;
+  u32 m_test_pipeline_id = 0;
+  // Diagnostics: how many shader modules translated+compiled vs fell
+  // back. Logged once so we can see how much of Dolphin's shader set
+  // Naga handles before the pipeline path exists.
+  u32 m_shader_ok = 0;
+  u32 m_shader_fail = 0;
+
+  // ---- Day-33 A3/A4/A5: real render-path recording state ----------
+  // Begin a render pass for the bound framebuffer if one isn't open
+  // (lazy — VideoCommon binds the FB then draws). Re-emits viewport/
+  // scissor since a new WebGPU pass resets them.
+  void BeginPassIfNeeded();
+  void EndPassIfOpen();
+  // Upload the 3 GX UBOs (when dirty) + assemble & set the 3 fixed
+  // bind groups (uniforms / samplers / ssbo) before a draw.
+  void PrepareDrawResources();
+
+  // §16 per-draw uniform versioning: bump-allocate a 256-aligned slice
+  // of the persistent uniform ring, copy `data` (size bytes) into it,
+  // emit UPLOAD_BUFFER, and return the slice's byte offset (used as a
+  // WebGPU dynamic offset). One shared buffer overwritten per draw made
+  // every draw read only the last upload's constants (the §16 root
+  // cause); distinct slices + dynamic offsets give each draw its own.
+  u32 AllocUboSlice(const void* data, u32 size);
+
+  bool m_pass_open = false;
+  u32 m_fb_color_id = 0;  // 0 = backbuffer
+  u32 m_fb_depth_id = 0;
+  bool m_pending_clear = false;
+  float m_clear_col[4] = {0.f, 0.f, 0.f, 1.f};
+
+  u32 m_cur_pipeline_id = 0;
+  u32 m_last_set_pipeline_id = 0;
+
+  float m_viewport[6] = {0, 0, 640, 480, 0.f, 1.f};
+  u32 m_scissor[4] = {0, 0, 640, 480};
+
+  u32 m_tex_id[8] = {0, 0, 0, 0, 0, 0, 0, 0};
+  u32 m_sampler_id = 0;
+  u32 m_sampler_packed = 0xffffffffu;  // force first CreateSampler
+
+  u32 m_ssbo_bbox = 0;
+  u32 m_dummy_tex = 0;
+
+  // §16 per-draw uniform ring. ONE persistent buffer; every dirty GX
+  // constant set / utility-uniform push bump-allocates a fresh slice so
+  // a later draw's upload can't clobber an earlier draw's constants
+  // (the conclusive textured-black root cause — single shared UBOs +
+  // batched one-submit-per-frame meant every draw saw the last upload).
+  // group0's 4 UBO bindings become dynamic-offset; the per-draw slice
+  // offsets ride SET_BIND_GROUP. SLICE = 8 KiB ≥ every UBO class
+  // (VertexShaderConstants ~4112 is the largest) and a multiple of the
+  // 256 B WebGPU dynamic-offset alignment. Ring sized for many frames
+  // of distinct constant sets (consumer is ≤2 frames behind).
+  static constexpr u32 kUboSliceStride = 8192;
+  static constexpr u32 kUboRingSize = 32u * 1024u * 1024u;
+  static constexpr u32 kUboOffNone = 0xFFFFFFFFu;  // force first alloc
+  u32 m_ubo_ring = 0;
+  u32 m_ubo_ring_off = 0;
+  u32 m_ps_off = kUboOffNone;
+  u32 m_vs_off = kUboOffNone;
+  u32 m_gs_off = kUboOffNone;
+  u32 m_util_off = kUboOffNone;
+  // §19/§20: VS constants can change without `vsm.dirty` being set —
+  // CPUCull's SetProjectionMatrix consumes DidProjectionChange() (and
+  // writes constants.projection) before SetConstants runs (§18/§19),
+  // and the same "constant updated on a path that doesn't set dirty"
+  // family also leaves Melee's 2D-UI posmtx/texmtx stale (§20: menu
+  // backgrounds rendered after §19 but UI quads still collapsed).
+  // Robust general fix: at draw time, re-slice the per-draw VS UBO
+  // whenever the WHOLE VertexShaderConstants block differs from what we
+  // last uploaded — not relying on `dirty` at all. This is exactly the
+  // §16/§17 per-draw-versioning intent; `dirty` was only ever an
+  // upload-skip optimisation and the content diff achieves the same
+  // skip while being immune to any missed-dirty path. One ~4 KB memcmp
+  // per draw (negligible). Shadow sized to the UBO-slice stride
+  // (≥ sizeof(VertexShaderConstants)).
+  std::array<u8, kUboSliceStride> m_vs_shadow{};
+  bool m_vs_shadow_valid = false;
+  // §21: same draw-time whole-block diff for PS (TEV) + GS constants —
+  // the §16 per-draw-clobber family afflicts pixel constants too;
+  // dirty-gated slicing left most textured draws on a stale PS slice
+  // ("only pieces" rendered). Shadows sized to the slice stride.
+  std::array<u8, kUboSliceStride> m_ps_shadow{};
+  bool m_ps_shadow_valid = false;
+  std::array<u8, kUboSliceStride> m_gs_shadow{};
+  bool m_gs_shadow_valid = false;
+  // Armed by UploadUtilityUniforms, consumed (and cleared) by the next
+  // recorded draw — selects the util slice for group0/binding0 instead
+  // of the GX PixelShaderConstants slice.
+  bool m_util_uniform_mode = false;
+
+  // Cached bind-group ids. group0 (UBOs) + group2 (ssbo) reference
+  // fixed buffers — created once, reused every draw (UBO *contents*
+  // change via writeBuffer; the GPUBindGroup stays valid). group1
+  // (textures+sampler) is rebuilt only when the bound texture set
+  // changes (keyed by m_bg1_sig). Prevents the per-draw bind-group
+  // explosion (was 1.7M/run).
+  u32 m_bg0_id = 0;
+  u32 m_bg2_id = 0;
+  // group1 (textures+sampler) signature→id cache. A single last-sig
+  // slot (the old m_bg1_sig/id) re-emitted CREATE_BIND_GROUP whenever
+  // consecutive draws used different texture sets — and Melee cycles
+  // through many per frame, so the ring overflowed (records DROPPED →
+  // missing resources → missBg → geometry never landed). A small
+  // direct-mapped cache makes a recurring signature reuse its id (the
+  // consumer dedupes builds by id), bounding CREATE_BIND_GROUP to the
+  // distinct material set instead of one-per-draw. Direct-mapped:
+  // collisions just cause an occasional harmless rebuild.
+  static constexpr u32 kBg1CacheSize = 1024;
+  struct Bg1Slot
+  {
+    u32 sig = 0;
+    u32 id = 0;  // 0 = empty (resource ids start at 1)
+  };
+  Bg1Slot m_bg1_cache[kBg1CacheSize] = {};
+};
+
+class WebGPUEFBInterface final : public EFBInterfaceBase
+{
+  void ReinterpretPixelData(EFBReinterpretType convtype) override;
+
+  void PokeColor(u16 x, u16 y, u32 color) override;
+  void PokeDepth(u16 x, u16 y, u32 depth) override;
+
+  u32 PeekColorInternal(u16 x, u16 y) override;
+  u32 PeekDepthInternal(u16 x, u16 y) override;
+};
+
+}  // namespace WebGPU
diff --git a/Source/Core/VideoBackends/WebGPU/WebGPUShaderTranslator.cpp b/Source/Core/VideoBackends/WebGPU/WebGPUShaderTranslator.cpp
new file mode 100644
index 0000000..5c6e730
--- /dev/null
+++ b/Source/Core/VideoBackends/WebGPU/WebGPUShaderTranslator.cpp
@@ -0,0 +1,243 @@
+// Copyright 2026 Dolphin Emulator Project (wasm-dolphin fork)
+// SPDX-License-Identifier: GPL-2.0-or-later
+
+#include "VideoBackends/WebGPU/WebGPUShaderTranslator.h"
+
+#include <glslang/Public/ShaderLang.h>
+#include <spirv-tools/libspirv.hpp>
+
+#include <algorithm>
+
+#include <emscripten/emscripten.h>
+
+#include "Common/Logging/Log.h"
+
+#include "VideoCommon/Spirv.h"
+
+// Day-23: C ABI of the Naga SPIR-V→WGSL staticlib (Rust, built for
+// wasm32-unknown-emscripten — tools/naga-spirv-wgsl, linked via the
+// dolphin_web_core CMakeLists). Returns a malloc'd NUL-terminated
+// WGSL string (or null on failure) that must be released with
+// naga_free_wgsl.
+extern "C" {
+char* naga_spirv_to_wgsl(const u32* spirv_ptr, size_t spirv_word_count);
+void naga_free_wgsl(char* ptr);
+// Day-30: last Naga failure reason ("spv-frontend: …" / "validate: …"
+// / "wgsl-backend: …"), valid until the next call on this thread.
+const char* naga_last_error(void);
+}
+
+namespace WebGPU
+{
+// §28cx: first shader-translation failure reason, surfaced in the on-screen
+// [webgpu-shader] summary (the console one-shot logs get evicted by the flood).
+static std::string s_last_xlat_error;
+const std::string& LastShaderTranslateError()
+{
+  return s_last_xlat_error;
+}
+
+namespace
+{
+// Day-24: Dolphin's shader generators emit GLSL *without* a preamble
+// — every hardware backend prepends its own. This is the Vulkan
+// backend's SHADER_HEADER verbatim (VideoBackends/Vulkan/
+// ShaderCompiler.cpp), minus the runtime-gated SUBGROUP/driver-bug
+// tails (no subgroup ops or AMD-Metal driver bugs in the wasm
+// build). Without these `#version`/extension lines and the
+// ATTRIBUTE_LOCATION / UBO_BINDING / float2→vec2 macros, glslang
+// rejects every real Dolphin shader (observed: ok=0 fail=64).
+constexpr std::string_view kShaderHeader = R"(
+  // Target GLSL 4.5.
+  #version 450 core
+
+  #extension GL_ARB_shading_language_include : enable
+  // Day-30: separate texture/sampler path (PixelShaderGen /
+  // FramebufferShaderGen) uses samplerless texelFetch on
+  // `texture2DArray`/`texture2DMSArray`. Required for that to compile.
+  #extension GL_EXT_samplerless_texture_functions : require
+
+  #define ATTRIBUTE_LOCATION(x) layout(location = x)
+  #define FRAGMENT_OUTPUT_LOCATION(x) layout(location = x)
+  #define FRAGMENT_OUTPUT_LOCATION_INDEXED(x, y) layout(location = x, index = y)
+  #define UBO_BINDING(packing, x) layout(packing, set = 0, binding = (x - 1))
+  #define SAMPLER_BINDING(x) layout(set = 1, binding = x)
+  #define TEXEL_BUFFER_BINDING(x) layout(set = 1, binding = (x + 8))
+  #define SSBO_BINDING(x) layout(std430, set = 2, binding = x)
+  #define INPUT_ATTACHMENT_BINDING(x, y, z) layout(set = x, binding = y, input_attachment_index = z)
+  #define VARYING_LOCATION(x) layout(location = x)
+  #define FORCE_EARLY_Z layout(early_fragment_tests) in
+
+  // Metal framebuffer fetch helpers.
+  #define FB_FETCH_VALUE subpassLoad(in_ocol0)
+
+  // hlsl to glsl function translation
+  #define API_VULKAN 1
+  #define float2 vec2
+  #define float3 vec3
+  #define float4 vec4
+  #define uint2 uvec2
+  #define uint3 uvec3
+  #define uint4 uvec4
+  #define int2 ivec2
+  #define int3 ivec3
+  #define int4 ivec4
+  #define frac fract
+  #define lerp mix
+
+  // These were changed in Vulkan
+  #define gl_VertexID gl_VertexIndex
+  #define gl_InstanceID gl_InstanceIndex
+)";
+
+std::string WithHeader(std::string_view glsl)
+{
+  std::string out;
+  out.reserve(kShaderHeader.size() + glsl.size());
+  out.append(kShaderHeader);
+  out.append(glsl);
+  return out;
+}
+}  // namespace
+
+std::optional<SpirvModule> GlslToSpirv(ShaderStage stage, std::string_view glsl_body)
+{
+  const std::string glsl = WithHeader(glsl_body);
+  // Reuse VideoCommon's glslang wrapper — the exact path the Vulkan
+  // backend uses. APIType::Vulkan is correct here: it selects the
+  // GLSL dialect glslang expects (explicit binding/location layout,
+  // Vulkan-style gl_ builtins), independent of which GPU API finally
+  // consumes the result. SPIR-V 1.0 keeps the bytecode within what a
+  // SPIR-V→WGSL transpiler accepts.
+  std::optional<SPIRV::CodeVector> code;
+  switch (stage)
+  {
+  case ShaderStage::Vertex:
+    code = SPIRV::CompileVertexShader(glsl, APIType::Vulkan, glslang::EShTargetSpv_1_0, nullptr);
+    break;
+  case ShaderStage::Geometry:
+    code = SPIRV::CompileGeometryShader(glsl, APIType::Vulkan, glslang::EShTargetSpv_1_0, nullptr);
+    break;
+  case ShaderStage::Pixel:
+    code = SPIRV::CompileFragmentShader(glsl, APIType::Vulkan, glslang::EShTargetSpv_1_0, nullptr);
+    break;
+  case ShaderStage::Compute:
+    code = SPIRV::CompileComputeShader(glsl, APIType::Vulkan, glslang::EShTargetSpv_1_0, nullptr);
+    break;
+  }
+
+  if (!code)
+  {
+    WARN_LOG_FMT(VIDEO, "WebGPU: glslang failed to compile {} shader to SPIR-V",
+                 static_cast<int>(stage));
+    return std::nullopt;
+  }
+
+  return SpirvModule{std::move(*code)};
+}
+
+std::optional<std::string> SpirvToWgsl(const SpirvModule& spirv)
+{
+  // Day-23: real SPIR-V → WGSL via the linked Naga staticlib.
+  if (spirv.code.empty())
+    return std::nullopt;
+
+  char* wgsl = naga_spirv_to_wgsl(spirv.code.data(), spirv.code.size());
+  if (!wgsl)
+  {
+    WARN_LOG_FMT(VIDEO, "WebGPU: Naga SPIR-V→WGSL returned null ({} SPIR-V words)",
+                 spirv.code.size());
+    return std::nullopt;
+  }
+
+  std::string out(wgsl);
+  naga_free_wgsl(wgsl);
+  return out;
+}
+
+std::optional<std::string> GlslToWgsl(ShaderStage stage, std::string_view glsl)
+{
+  auto spirv = GlslToSpirv(stage, glsl);
+  if (!spirv)
+  {
+    // Day-24 diagnostics: which stage fails for real Dolphin shaders?
+    // One-shot dump (first failure only) of the offending GLSL so we
+    // can see exactly what glslang choked on (e.g. #include, an
+    // unsupported builtin). Capped + truncated to keep the log sane.
+    static bool dumped = false;
+    if (!dumped)
+    {
+      dumped = true;
+      const std::string body(glsl.substr(0, std::min<size_t>(glsl.size(), 700)));
+      EM_ASM(
+          {
+            if (typeof console !== 'undefined')
+              console.log('[webgpu-shader-fail] stage=' + $0 +
+                          ' glslang->SPIRV FAILED. GLSL head:\n' +
+                          UTF8ToString($1));
+          },
+          static_cast<int>(stage), body.c_str());
+    }
+    if (s_last_xlat_error.empty())
+      s_last_xlat_error = "glslang-fail stage=" + std::to_string(static_cast<int>(stage));
+    return std::nullopt;
+  }
+
+  auto wgsl = SpirvToWgsl(*spirv);
+  if (!wgsl)
+  {
+    // §28cx: capture the Naga error FIRST (valid until the next naga call) for
+    // the on-screen summary, before the disasm/spvtools calls below.
+    if (s_last_xlat_error.empty())
+    {
+      const char* ne = naga_last_error();
+      s_last_xlat_error = std::string("naga[s") + std::to_string(static_cast<int>(stage)) +
+                          "]: " + (ne && *ne ? ne : "<null>");
+    }
+    static int naga_dumps = 0;
+    if (naga_dumps < 5)
+    {
+      ++naga_dumps;
+      const char* nerr = naga_last_error();
+      EM_ASM(
+          {
+            if (typeof console !== 'undefined')
+              console.log('[webgpu-shader-fail] stage=' + $0 +
+                          ' SPIRV->WGSL (Naga) FAILED words=' + $1 +
+                          ' :: ' + (UTF8ToString($2) || '<no err>'));
+          },
+          static_cast<int>(stage), static_cast<int>(spirv->code.size()),
+          nerr ? nerr : "");
+    }
+    // Day-30 probe: disassemble the FIRST rejected shader so we can
+    // see exactly what defines/references the systematic "invalid id
+    // %14" (same id across many shaders ⇒ one common glslang
+    // construct Naga's spv frontend can't parse). One-shot, early
+    // section only — that's where the offending id lives.
+    static bool disasm_done = false;
+    if (!disasm_done)
+    {
+      disasm_done = true;
+      spvtools::SpirvTools tools(SPV_ENV_VULKAN_1_0);
+      std::string text;
+      if (tools.Disassemble(spirv->code, &text,
+                            SPV_BINARY_TO_TEXT_OPTION_FRIENDLY_NAMES |
+                                SPV_BINARY_TO_TEXT_OPTION_INDENT))
+      {
+        // Cap: the id Naga chokes on is in the
+        // capability/type/decoration prologue; first ~2.5 KB covers it.
+        if (text.size() > 2600)
+          text.resize(2600);
+        EM_ASM(
+            {
+              if (typeof console !== 'undefined')
+                console.log('[webgpu-spirv-dis] first-rejected SPIR-V:\n' +
+                            UTF8ToString($0));
+            },
+            text.c_str());
+      }
+    }
+  }
+  return wgsl;
+}
+}  // namespace WebGPU
diff --git a/Source/Core/VideoBackends/WebGPU/WebGPUShaderTranslator.h b/Source/Core/VideoBackends/WebGPU/WebGPUShaderTranslator.h
new file mode 100644
index 0000000..18282a1
--- /dev/null
+++ b/Source/Core/VideoBackends/WebGPU/WebGPUShaderTranslator.h
@@ -0,0 +1,60 @@
+// Copyright 2026 Dolphin Emulator Project (wasm-dolphin fork)
+// SPDX-License-Identifier: GPL-2.0-or-later
+
+#pragma once
+
+#include <optional>
+#include <string>
+#include <string_view>
+#include <vector>
+
+#include "Common/CommonTypes.h"
+#include "VideoCommon/AbstractShader.h"
+
+// Day-22: shader translation foundation for the WebGPU *hardware*
+// renderer.
+//
+// Dolphin's shader generators (PixelShaderGen / VertexShaderGen /
+// UberShader*) emit GLSL. The browser's WebGPU only accepts WGSL —
+// SPIR-V shader modules are explicitly unsupported in the Wasm path
+// ("ShaderSourceSPIRV requested, but not supported in Wasm",
+// emdawnwebgpu webgpu.cpp). So a real WebGPU backend must translate
+// GLSL → WGSL.
+//
+// The only reuse-friendly route (chosen over hand-writing a WGSL
+// emitter) is:
+//
+//     Dolphin GLSL ──glslang──▶ SPIR-V ──[Naga/Tint]──▶ WGSL
+//
+// glslang is already compiled into the wasm build (Externals/glslang,
+// linked for the Vulkan backend) and exposed via VideoCommon's
+// SPIRV::Compile*Shader. So GLSL→SPIR-V is available *now*. The
+// SPIR-V→WGSL step needs a transpiler that doesn't yet exist in the
+// build; that integration (Naga compiled to wasm, run in the discio
+// worker) is the next sub-project. Until it lands SpirvToWgsl returns
+// nullopt and the backend keeps using the Day-18 Software-rasteriser
+// path for actual pixels.
+namespace WebGPU
+{
+struct SpirvModule
+{
+  std::vector<u32> code;
+};
+
+// GLSL → SPIR-V using glslang (via VideoCommon's SPIRV helper). This
+// half works today in the wasm build. Returns nullopt on compile
+// failure (logged).
+std::optional<SpirvModule> GlslToSpirv(ShaderStage stage, std::string_view glsl);
+
+// SPIR-V → WGSL. Placeholder until the Naga/Tint transpiler is
+// integrated (see header comment). Always returns nullopt for now.
+std::optional<std::string> SpirvToWgsl(const SpirvModule& spirv);
+
+// Convenience: full GLSL → WGSL. Returns nullopt if either stage fails.
+std::optional<std::string> GlslToWgsl(ShaderStage stage, std::string_view glsl);
+
+// §28cx: the FIRST shader-translation failure reason (glslang or Naga),
+// captured for the on-screen [webgpu-shader] summary so the error survives the
+// console flood. Empty if no failure yet.
+const std::string& LastShaderTranslateError();
+}  // namespace WebGPU
diff --git a/Source/Core/VideoBackends/WebGPU/WebGPUTexture.cpp b/Source/Core/VideoBackends/WebGPU/WebGPUTexture.cpp
new file mode 100644
index 0000000..d96136d
--- /dev/null
+++ b/Source/Core/VideoBackends/WebGPU/WebGPUTexture.cpp
@@ -0,0 +1,283 @@
+// Copyright 2026 Dolphin Emulator Project (wasm-dolphin fork)
+// SPDX-License-Identifier: GPL-2.0-or-later
+
+#include "VideoBackends/WebGPU/WebGPUTexture.h"
+
+#include <algorithm>
+#include <cstring>
+
+#include "VideoBackends/WebGPU/WebGPUCommandStream.h"
+
+namespace WebGPU
+{
+// AbstractTextureFormat → WebGPU GPUTextureFormat code (consumer maps
+// code→string). Kept in sync with the consumer's WGPU_TEX_FORMAT
+// table in upstream-discio-worker.js.
+static u32 MapTexFormat(AbstractTextureFormat f)
+{
+  switch (f)
+  {
+  case AbstractTextureFormat::RGBA8: return 0;   // rgba8unorm
+  case AbstractTextureFormat::BGRA8: return 1;   // bgra8unorm
+  case AbstractTextureFormat::RGB10_A2: return 8;  // rgb10a2unorm
+  case AbstractTextureFormat::RGBA16F: return 5;   // rgba16float
+  case AbstractTextureFormat::R16: return 6;       // r16uint
+  case AbstractTextureFormat::R32F: return 7;      // r32float
+  case AbstractTextureFormat::D16: return 2;       // depth24plus (approx)
+  case AbstractTextureFormat::D24_S8: return 4;    // depth24plus-stencil8
+  case AbstractTextureFormat::D32F: return 3;      // depth32float
+  case AbstractTextureFormat::D32F_S8: return 3;   // depth32float (approx)
+  default: return 0;                               // DXT/BPTC: TODO grind
+  }
+}
+
+// GPUTextureUsage: COPY_SRC 1, COPY_DST 2, TEXTURE_BINDING 4,
+// RENDER_ATTACHMENT 0x10. Over-permissive is fine (all core).
+static constexpr u32 kTexUsage = 1u | 2u | 4u | 0x10u;
+
+// Day-17 phase 3: WebGPUTexture now allocates layer/level/pixel
+// storage (mirrors SWTexture). VideoCommon's existing XFB-decode-
+// from-RAM path calls Load() to populate the texture from emulated
+// GameCube memory; WebGPUGfx::ShowImage then reads GetData(0, 0) to
+// hand the pixels off to the JS wgpu blit. Day-18+ will swap this
+// CPU storage for a real WGPUTexture and move the upload onto the
+// GPU side via wgpuQueueWriteTexture.
+
+WebGPUTexture::WebGPUTexture(const TextureConfig& tex_config) : AbstractTexture(tex_config)
+{
+  const size_t texel_size = GetTexelSizeForFormat(tex_config.format);
+  m_data.resize(tex_config.layers);
+  for (u32 layer = 0; layer < tex_config.layers; layer++)
+  {
+    m_data[layer].resize(tex_config.levels);
+    for (u32 level = 0; level < tex_config.levels; level++)
+    {
+      const u32 level_width = std::max(tex_config.width >> level, 1u);
+      const u32 level_height = std::max(tex_config.height >> level, 1u);
+      m_data[layer][level].resize(static_cast<size_t>(level_width) * level_height * texel_size);
+    }
+  }
+
+  // Day-33 A4: mirror this as a real GPUTexture on the discio worker.
+  // 0 if the ring isn't live yet (CPU-only fallback, like the SW
+  // hybrid) — Load() retries the id lazily.
+  WebGPUCommandStream& cs = GetCommandStream();
+  cs.EnsureRing();
+  if (cs.ready())
+  {
+    m_bridge_id = cs.PushCreateTexture(tex_config.width, tex_config.height,
+                                       MapTexFormat(tex_config.format), kTexUsage,
+                                       tex_config.layers);
+  }
+}
+
+u32 WebGPUTexture::EnsureBridgeId()
+{
+  if (m_bridge_id != 0)
+    return m_bridge_id;
+  WebGPUCommandStream& cs = GetCommandStream();
+  cs.EnsureRing();
+  if (cs.ready())
+    m_bridge_id = cs.PushCreateTexture(m_config.width, m_config.height,
+                                       MapTexFormat(m_config.format), kTexUsage,
+                                       m_config.layers);
+  return m_bridge_id;
+}
+
+void WebGPUTexture::EmitUpload(u32 level, u32 width, u32 height, u32 layer)
+{
+  WebGPUCommandStream& cs = GetCommandStream();
+  if (EnsureBridgeId() == 0)
+    return;
+  const size_t texel_size = GetTexelSizeForFormat(m_config.format);
+  const u32 bytes_per_row = static_cast<u32>(width * texel_size);
+  const u8* data = GetData(layer, level);
+  const u32 len = bytes_per_row * height;
+  const u32 src = cs.UploadAlloc(data, len, 4);
+  if (src != 0)
+    cs.PushUploadTexture(m_bridge_id, src, bytes_per_row, width, height, level, layer);
+}
+
+WebGPUTexture::~WebGPUTexture() = default;
+
+void WebGPUTexture::CopyRectangleFromTexture(const AbstractTexture* src,
+                                             const MathUtil::Rectangle<int>& src_rect,
+                                             u32 src_layer, u32 src_level,
+                                             const MathUtil::Rectangle<int>& dst_rect,
+                                             u32 dst_layer, u32 dst_level)
+{
+  if (!src)
+    return;
+
+  const TextureConfig& src_config = src->GetConfig();
+  const size_t texel_size = GetTexelSizeForFormat(src_config.format);
+  const size_t src_stride = src_config.GetMipStride(src_level);
+  const size_t dst_stride = m_config.GetMipStride(dst_level);
+
+  const u8* src_data = static_cast<const WebGPUTexture*>(src)->GetData(src_layer, src_level);
+  u8* dst_data = GetData(dst_layer, dst_level);
+  const size_t src_offset =
+      static_cast<size_t>(src_rect.top) * src_stride +
+      static_cast<size_t>(src_rect.left) * texel_size;
+  const size_t dst_offset =
+      static_cast<size_t>(dst_rect.top) * dst_stride +
+      static_cast<size_t>(dst_rect.left) * texel_size;
+  const size_t copy_width =
+      static_cast<size_t>(std::min(src_rect.GetWidth(), dst_rect.GetWidth())) * texel_size;
+  const u32 copy_height =
+      static_cast<u32>(std::min(src_rect.GetHeight(), dst_rect.GetHeight()));
+
+  const u8* src_row = src_data + src_offset;
+  u8* dst_row = dst_data + dst_offset;
+  for (u32 y = 0; y < copy_height; y++)
+  {
+    std::memcpy(dst_row, src_row, copy_width);
+    src_row += src_stride;
+    dst_row += dst_stride;
+  }
+
+  // Day-33 grind: the CPU memcpy above keeps any incidental
+  // AbstractTexture readback honest, but the *visible* path is the
+  // GPU XFB — emit a real GPU blit so the rendered EFB actually
+  // reaches it (EFB rgba8unorm → XFB bgra8unorm: the consumer picks
+  // copyTextureToTexture or a sampled render-pass blit per formats).
+  const u32 src_id = static_cast<const WebGPUTexture*>(src)->GetBridgeId();
+  const u32 dst_id = EnsureBridgeId();
+  if (src_id != 0 && dst_id != 0)
+  {
+    const auto clamp0 = [](int v) { return v < 0 ? 0u : static_cast<u32>(v); };
+    GetCommandStream().PushBlitTexture(
+        src_id, dst_id, clamp0(src_rect.left), clamp0(src_rect.top),
+        clamp0(src_rect.GetWidth()), clamp0(src_rect.GetHeight()), clamp0(dst_rect.left),
+        clamp0(dst_rect.top), clamp0(dst_rect.GetWidth()), clamp0(dst_rect.GetHeight()),
+        src_layer, src_level, dst_layer, dst_level);
+  }
+}
+
+void WebGPUTexture::ResolveFromTexture(const AbstractTexture* src,
+                                       const MathUtil::Rectangle<int>& rect, u32 layer,
+                                       u32 level)
+{
+  if (!src)
+    return;
+  // samples==1 in this backend, so an MSAA resolve is just a copy of
+  // `rect` (src layer/level) into the same region of `this`.
+  const u32 src_id = static_cast<const WebGPUTexture*>(src)->GetBridgeId();
+  const u32 dst_id = EnsureBridgeId();
+  if (src_id == 0 || dst_id == 0)
+    return;
+  const auto clamp0 = [](int v) { return v < 0 ? 0u : static_cast<u32>(v); };
+  GetCommandStream().PushBlitTexture(
+      src_id, dst_id, clamp0(rect.left), clamp0(rect.top), clamp0(rect.GetWidth()),
+      clamp0(rect.GetHeight()), clamp0(rect.left), clamp0(rect.top),
+      clamp0(rect.GetWidth()), clamp0(rect.GetHeight()), layer, level, layer, level);
+}
+
+void WebGPUTexture::Load(u32 level, u32 width, u32 height, u32 row_length, const u8* buffer,
+                         size_t /* buffer_size */, u32 layer)
+{
+  if (!buffer)
+    return;
+  const size_t texel_size = GetTexelSizeForFormat(m_config.format);
+  u8* data = GetData(layer, level);
+  for (u32 y = 0; y < height; y++)
+  {
+    std::memcpy(&data[static_cast<size_t>(width) * y * texel_size],
+                &buffer[static_cast<size_t>(row_length) * y * texel_size],
+                static_cast<size_t>(width) * texel_size);
+  }
+  // Day-33 A4: push the just-loaded mip to the GPU texture.
+  EmitUpload(level, width, height, layer);
+}
+
+const u8* WebGPUTexture::GetData(u32 layer, u32 level) const
+{
+  return m_data[layer][level].data();
+}
+
+u8* WebGPUTexture::GetData(u32 layer, u32 level)
+{
+  return m_data[layer][level].data();
+}
+
+WebGPUStagingTexture::WebGPUStagingTexture(StagingTextureType type, const TextureConfig& config)
+    : AbstractStagingTexture(type, config)
+{
+  // Provide a host-readable buffer so any incidental readback through
+  // the AbstractStagingTexture interface produces zero-filled pixels
+  // (rather than reading uninitialized memory). Real WebGPU storage
+  // comes later.
+  m_buffer.resize(m_texel_size * config.width * config.height);
+  m_map_pointer = reinterpret_cast<char*>(m_buffer.data());
+  m_map_stride = m_texel_size * config.width;
+}
+
+WebGPUStagingTexture::~WebGPUStagingTexture() = default;
+
+void WebGPUStagingTexture::CopyFromTexture(const AbstractTexture* /* src */,
+                                           const MathUtil::Rectangle<int>& /* src_rect */,
+                                           u32 /* src_layer */, u32 /* src_level */,
+                                           const MathUtil::Rectangle<int>& /* dst_rect */)
+{
+  m_needs_flush = true;
+}
+
+void WebGPUStagingTexture::CopyToTexture(const MathUtil::Rectangle<int>& /* src_rect */,
+                                          AbstractTexture* /* dst */,
+                                          const MathUtil::Rectangle<int>& /* dst_rect */,
+                                          u32 /* dst_layer */, u32 /* dst_level */)
+{
+  m_needs_flush = true;
+}
+
+bool WebGPUStagingTexture::Map()
+{
+  return true;
+}
+
+void WebGPUStagingTexture::Unmap()
+{
+}
+
+void WebGPUStagingTexture::Flush()
+{
+  m_needs_flush = false;
+}
+
+WebGPUFramebuffer::WebGPUFramebuffer(AbstractTexture* color_attachment,
+                                     AbstractTexture* depth_attachment,
+                                     std::vector<AbstractTexture*> additional_color_attachments,
+                                     AbstractTextureFormat color_format,
+                                     AbstractTextureFormat depth_format, u32 width, u32 height,
+                                     u32 layers, u32 samples)
+    : AbstractFramebuffer(color_attachment, depth_attachment,
+                          std::move(additional_color_attachments), color_format, depth_format,
+                          width, height, layers, samples)
+{
+}
+
+WebGPUFramebuffer::~WebGPUFramebuffer() = default;
+
+std::unique_ptr<WebGPUFramebuffer>
+WebGPUFramebuffer::Create(WebGPUTexture* color_attachment, WebGPUTexture* depth_attachment,
+                          std::vector<AbstractTexture*> additional_color_attachments)
+{
+  if (!ValidateConfig(color_attachment, depth_attachment, additional_color_attachments))
+    return nullptr;
+
+  const AbstractTextureFormat color_format =
+      color_attachment ? color_attachment->GetFormat() : AbstractTextureFormat::Undefined;
+  const AbstractTextureFormat depth_format =
+      depth_attachment ? depth_attachment->GetFormat() : AbstractTextureFormat::Undefined;
+  const WebGPUTexture* either_attachment = color_attachment ? color_attachment : depth_attachment;
+  const u32 width = either_attachment->GetWidth();
+  const u32 height = either_attachment->GetHeight();
+  const u32 layers = either_attachment->GetLayers();
+  const u32 samples = either_attachment->GetSamples();
+
+  return std::make_unique<WebGPUFramebuffer>(color_attachment, depth_attachment,
+                                             std::move(additional_color_attachments), color_format,
+                                             depth_format, width, height, layers, samples);
+}
+
+}  // namespace WebGPU
diff --git a/Source/Core/VideoBackends/WebGPU/WebGPUTexture.h b/Source/Core/VideoBackends/WebGPU/WebGPUTexture.h
new file mode 100644
index 0000000..78f49ea
--- /dev/null
+++ b/Source/Core/VideoBackends/WebGPU/WebGPUTexture.h
@@ -0,0 +1,94 @@
+// Copyright 2026 Dolphin Emulator Project (wasm-dolphin fork)
+// SPDX-License-Identifier: GPL-2.0-or-later
+
+#pragma once
+
+#include <memory>
+#include <vector>
+
+#include "Common/CommonTypes.h"
+
+#include "VideoCommon/AbstractFramebuffer.h"
+#include "VideoCommon/AbstractStagingTexture.h"
+#include "VideoCommon/AbstractTexture.h"
+
+namespace WebGPU
+{
+// Day-17 phase 3: WebGPUTexture stores real pixel data CPU-side.
+// VideoCommon's XFB-from-RAM decoder calls Load() to populate this
+// from emulated GameCube memory; CopyRectangleFromTexture moves
+// pixels between textures. Day-17 phase 4 (`WebGPUGfx::ShowImage`)
+// reads GetData() and routes the bytes through the JS bridge for a
+// real wgpu render-pass blit on the canvas.
+//
+// The triple-nested vector shape mirrors `SWTexture::m_data` so the
+// indexing pattern from VideoCommon (layer → mip level → row-major
+// pixels) works identically. Pure scaffolding for the Day-18+ shift
+// to real WGPUTexture-backed storage and on-GPU uploads.
+class WebGPUTexture final : public AbstractTexture
+{
+public:
+  explicit WebGPUTexture(const TextureConfig& config);
+  ~WebGPUTexture() override;
+
+  void CopyRectangleFromTexture(const AbstractTexture* src,
+                                const MathUtil::Rectangle<int>& src_rect, u32 src_layer,
+                                u32 src_level, const MathUtil::Rectangle<int>& dst_rect,
+                                u32 dst_layer, u32 dst_level) override;
+  void ResolveFromTexture(const AbstractTexture* src, const MathUtil::Rectangle<int>& rect,
+                          u32 layer, u32 level) override;
+  void Load(u32 level, u32 width, u32 height, u32 row_length, const u8* buffer, size_t buffer_size,
+            u32 layer) override;
+
+  const u8* GetData(u32 layer, u32 level) const;
+  u8* GetData(u32 layer, u32 level);
+
+  // Day-33 A4: consumer-side GPUTexture id (0 if the ring wasn't ready
+  // at construction — falls back to CPU-only, like the SW hybrid).
+  u32 GetBridgeId() const { return m_bridge_id; }
+
+private:
+  // Lazily allocate the consumer-side GPUTexture id if the ring wasn't
+  // ready at construction; returns it (0 if still unavailable).
+  u32 EnsureBridgeId();
+  void EmitUpload(u32 level, u32 width, u32 height, u32 layer);
+
+  std::vector<std::vector<std::vector<u8>>> m_data;
+  u32 m_bridge_id = 0;
+};
+
+class WebGPUStagingTexture final : public AbstractStagingTexture
+{
+public:
+  WebGPUStagingTexture(StagingTextureType type, const TextureConfig& config);
+  ~WebGPUStagingTexture() override;
+
+  void CopyFromTexture(const AbstractTexture* src, const MathUtil::Rectangle<int>& src_rect,
+                       u32 src_layer, u32 src_level,
+                       const MathUtil::Rectangle<int>& dst_rect) override;
+  void CopyToTexture(const MathUtil::Rectangle<int>& src_rect, AbstractTexture* dst,
+                     const MathUtil::Rectangle<int>& dst_rect, u32 dst_layer,
+                     u32 dst_level) override;
+  bool Map() override;
+  void Unmap() override;
+  void Flush() override;
+
+private:
+  std::vector<u8> m_buffer;
+};
+
+class WebGPUFramebuffer final : public AbstractFramebuffer
+{
+public:
+  WebGPUFramebuffer(AbstractTexture* color_attachment, AbstractTexture* depth_attachment,
+                    std::vector<AbstractTexture*> additional_color_attachments,
+                    AbstractTextureFormat color_format, AbstractTextureFormat depth_format,
+                    u32 width, u32 height, u32 layers, u32 samples);
+  ~WebGPUFramebuffer() override;
+
+  static std::unique_ptr<WebGPUFramebuffer>
+  Create(WebGPUTexture* color_attachment, WebGPUTexture* depth_attachment,
+         std::vector<AbstractTexture*> additional_color_attachments);
+};
+
+}  // namespace WebGPU
diff --git a/Source/Core/VideoBackends/WebGPU/WebGPUVertexManager.cpp b/Source/Core/VideoBackends/WebGPU/WebGPUVertexManager.cpp
new file mode 100644
index 0000000..c47a776
--- /dev/null
+++ b/Source/Core/VideoBackends/WebGPU/WebGPUVertexManager.cpp
@@ -0,0 +1,131 @@
+// Copyright 2026 Dolphin Emulator Project (wasm-dolphin fork)
+// SPDX-License-Identifier: GPL-2.0-or-later
+
+#include "VideoBackends/WebGPU/WebGPUVertexManager.h"
+
+#include <cstring>
+
+#include <emscripten/emscripten.h>
+
+#include "VideoBackends/WebGPU/WebGPUCommandStream.h"
+#include "VideoBackends/WebGPU/WebGPUGfx.h"
+
+#include "VideoCommon/AbstractGfx.h"
+
+namespace WebGPU
+{
+// GPUBufferUsage numeric flags (DESIGN doc): VERTEX 0x20, INDEX 0x10,
+// COPY_DST 0x8.
+static constexpr u32 kUsageVertex = 0x20 | 0x8;
+static constexpr u32 kUsageIndex = 0x10 | 0x8;
+
+VertexManager::VertexManager() = default;
+VertexManager::~VertexManager() = default;
+
+bool VertexManager::Initialize()
+{
+  if (!VertexManagerBase::Initialize())
+    return false;
+  // Buffers are created lazily once the ring is live (EnsureBuffers),
+  // since the discio worker may not have handed the ring over yet at
+  // VideoBackend::Initialize time.
+  return true;
+}
+
+void VertexManager::EnsureBuffers()
+{
+  WebGPUCommandStream& cs = GetCommandStream();
+  cs.EnsureRing();
+  if (!cs.ready())
+    return;
+  if (m_vertex_buffer_id == 0)
+    m_vertex_buffer_id = cs.PushCreateBuffer(kVertexBufferSize, kUsageVertex);
+  if (m_index_buffer_id == 0)
+    m_index_buffer_id = cs.PushCreateBuffer(kIndexBufferSize, kUsageIndex);
+}
+
+void VertexManager::CommitBuffer(u32 num_vertices, u32 vertex_stride, u32 num_indices,
+                                 u32* out_base_vertex, u32* out_base_index)
+{
+  *out_base_vertex = 0;
+  *out_base_index = 0;
+
+  EnsureBuffers();
+  WebGPUCommandStream& cs = GetCommandStream();
+  if (m_vertex_buffer_id == 0 || m_index_buffer_id == 0)
+    return;
+
+  if (vertex_stride == 0)
+    return;
+  // queue.writeBuffer requires the destination offset AND the byte
+  // count to be multiples of 4. Vertex stride is always 4-aligned
+  // (OGLNativeVertexFormat panics otherwise) so a stride-aligned
+  // vertex offset is 4-aligned; round the index region + both upload
+  // lengths up to 4 (the few padding bytes stay within the buffer and
+  // are never indexed).
+  const u32 vbytes = (num_vertices * vertex_stride + 3u) & ~3u;
+  const u32 ibytes = (num_indices * static_cast<u32>(sizeof(u16)) + 3u) & ~3u;
+
+  u32 voff = (m_vertex_offset + vertex_stride - 1) / vertex_stride * vertex_stride;
+  if (voff + vbytes > kVertexBufferSize)
+    voff = 0;
+  u32 ioff = (m_index_offset + 3u) & ~3u;
+  if (ioff + ibytes > kIndexBufferSize)
+    ioff = 0;
+  m_vertex_offset = voff + vbytes;
+  m_index_offset = ioff + ibytes;
+  m_last_vertex_byte = voff;
+  m_last_index_byte = ioff;
+
+  // DIAG one-shot: are the assembled vertex bytes non-degenerate?
+  // Dump counts/stride + first 6 floats of the batch (the first
+  // vertex's leading attribute, usually position). All-zero ⇒
+  // vertices collapse ⇒ black EFB.
+  static bool s_diag_v = false;
+  if (!s_diag_v && vbytes != 0 && m_base_buffer_pointer)
+  {
+    s_diag_v = true;
+    EM_ASM(
+        {
+          console.log('[webgpu-DIAG-vtx] nv=' + $0 + ' stride=' + $1 +
+            ' ni=' + $2 + ' v0=' +
+            HEAPF32[($3>>2)+0].toFixed(3) + ',' +
+            HEAPF32[($3>>2)+1].toFixed(3) + ',' +
+            HEAPF32[($3>>2)+2].toFixed(3) + ',' +
+            HEAPF32[($3>>2)+3].toFixed(3) + ',' +
+            HEAPF32[($3>>2)+4].toFixed(3) + ',' +
+            HEAPF32[($3>>2)+5].toFixed(3));
+        },
+        static_cast<int>(num_vertices), static_cast<int>(vertex_stride),
+        static_cast<int>(num_indices),
+        reinterpret_cast<intptr_t>(m_base_buffer_pointer));
+  }
+
+  // The base class assembled the batch into the CPU staging buffers.
+  if (vbytes != 0)
+  {
+    const u32 src = cs.UploadAlloc(m_base_buffer_pointer, vbytes, 4);
+    if (src != 0)
+      cs.PushUploadBuffer(m_vertex_buffer_id, voff, src, vbytes);
+  }
+  if (ibytes != 0)
+  {
+    const u32 src = cs.UploadAlloc(m_cpu_index_buffer.data(), ibytes, 4);
+    if (src != 0)
+      cs.PushUploadBuffer(m_index_buffer_id, ioff, src, ibytes);
+  }
+
+  // Vertex buffer is bound at offset 0; address this batch via
+  // base_vertex (mirrors the Vulkan backend). Indices likewise via
+  // first_index.
+  *out_base_vertex = voff / vertex_stride;
+  *out_base_index = ioff / static_cast<u32>(sizeof(u16));
+}
+
+void VertexManager::UploadUtilityUniforms(const void* uniforms, u32 uniforms_size)
+{
+  if (g_gfx)
+    static_cast<WebGPUGfx*>(g_gfx.get())->UploadUtilityUniforms(uniforms, uniforms_size);
+}
+
+}  // namespace WebGPU

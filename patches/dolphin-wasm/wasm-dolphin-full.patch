+void UpdatePerformanceMonitorIfNeeded(u32 cycles, u32 num_load_stores, u32 num_fp_inst,
+                                      PowerPC::PowerPCState& ppc_state)
+{
+  if ((ppc_state.feature_flags & FEATURE_FLAG_PERFMON) != 0)

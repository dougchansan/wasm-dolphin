+namespace WebGPU
+{
+// Day-18: WebGPUGfx is a "SWGfx without a GL window". CreateTexture /
+// CreateFramebuffer return Software's classes (SWTexture / SWFramebuffer)
+// so the Software rasteriser's `static_cast<SWTexture*>(...)` calls work
+// inside the chain (Clipper / Rasterizer / SWVertexLoader / SWPixelEngine
+// all assume SWTexture).
+//
+// The only AbstractGfx hook that diverges from Software's behaviour is
+// ShowImage: instead of `SWOGLWindow::ShowImage` (which uses GL) we
+// extract the SWTexture's pixel buffer and postMessage it to the discio
+// worker, which uploads + blits via a real `wgpuRenderPass` through the
+// existing WebGPU presenter. Days 19+ progressively replace pieces
+// (clears, copies, draws) with native wgpu operations until SW drops
+// out of the chain entirely.
+
+WebGPUGfx::WebGPUGfx()
+{
+  UpdateActiveConfig();
+}
+
+WebGPUGfx::~WebGPUGfx()
+{
+  UpdateActiveConfig();
+}
+
+void WebGPUGfx::EnsureDevice()
+{
+  // Already resolved (acquired or permanently failed) → nothing to do.
+  if (m_device_state != 0)
+    return;
+
+  // Poll the async request kicked in VideoBackend::Initialize. Returns
+  // 1=ready, -1=failed/unavailable, 0=still pending.
+  const int status = EM_ASM_INT({
+    if (typeof self === 'undefined') return -1;
+    var s = self.__dolphinPthreadWgpuStatus;
+    if (s === 'ready' && self.__dolphinPthreadWgpuDevice) return 1;
+    if (s === 'unavailable' || s === 'no-adapter' || s === 'error' ||
+        s === 'lost') return -1;
+    return 0;  // pending / undefined
+  });
+
+  // Day-26 diagnostic: surface navigator.gpu presence + the raw
+  // status string a few times so we can tell whether the pthread
+  // even has WebGPU and whether the async ever progresses past
+  // 'pending' (event-loop-turn hypothesis).
+  static int s_poll_log = 0;
+  if (s_poll_log < 6)
+  {
+    ++s_poll_log;
+    EM_ASM({
+      if (typeof console !== 'undefined')
+        console.log('[webgpu-dev] poll: hasNavGpu=' +
+          ((typeof self !== 'undefined' && self.navigator && self.navigator.gpu) ? 1 : 0) +
+          ' status=' + ((typeof self !== 'undefined' && self.__dolphinPthreadWgpuStatus) || 'none'));
+    });
+  }
+
+  if (status == 0)
+    return;
+  if (status < 0)
+  {
+    m_device_state = -1;
+    return;
+  }
+
+  // Ready: hand the JS device to emdawnwebgpu's importer via the
+  // Module slot it already understands, then pull a thread-local
+  // WGPUDevice handle out of it. This imports into THIS pthread's
+  // object table (valid here, unlike the discio-worker device).
+  EM_ASM({
+    if (typeof Module !== 'undefined')
+      Module['preinitializedWebGPUDevice'] = self.__dolphinPthreadWgpuDevice;
+  });
+  m_device = emscripten_webgpu_get_device();
+  m_device_state = m_device ? 1 : -1;
+
+  EM_ASM({
+    if (typeof console !== 'undefined')
+      console.log('[webgpu-dev] C++ imported pthread device, handle=' + $0 +
+                  ' state=' + $1);
+  }, static_cast<int>(reinterpret_cast<intptr_t>(m_device)), m_device_state);
+}
+
+bool WebGPUGfx::IsHeadless() const
+{
+  // We present to the WebGPU canvas via the discio worker, so we're
+  // not headless even though we don't own a GL context like SWGfx
+  // normally does.
+  return false;
+}
+
+bool WebGPUGfx::SupportsUtilityDrawing() const
+{
+  // Day-33 Phase C: real GPU render path. VideoCommon now drives the
+  // full Renderer (SetPipeline/SetFramebuffer/DrawIndexed/...) which
+  // we record as opcodes — no more ShowImage(xfb) SW-hybrid fallback.
+  return true;
+}
+
+std::unique_ptr<AbstractTexture> WebGPUGfx::CreateTexture(const TextureConfig& config,
+                                                          std::string_view /* name */)
+{
+  // Day-33 Phase C: real WebGPUTexture (ctor emits CREATE_TEXTURE,
+  // carries a consumer GPUTexture bridge id).
+  return std::make_unique<WebGPUTexture>(config);
+}
+
+std::unique_ptr<AbstractStagingTexture>
+WebGPUGfx::CreateStagingTexture(StagingTextureType type, const TextureConfig& config)
+{
+  return std::make_unique<WebGPUStagingTexture>(type, config);
+}
+
+std::unique_ptr<AbstractFramebuffer>
+WebGPUGfx::CreateFramebuffer(AbstractTexture* color_attachment, AbstractTexture* depth_attachment,
+                             std::vector<AbstractTexture*> additional_color_attachments)
+{
+  return WebGPUFramebuffer::Create(static_cast<WebGPUTexture*>(color_attachment),
+                                   static_cast<WebGPUTexture*>(depth_attachment),
+                                   std::move(additional_color_attachments));
+}
+
+// Day-24: a real shader. When the GLSL→SPIR-V→WGSL chain succeeds and
+// the device builds a module, m_module is non-null and m_wgsl holds
+// the translated source (kept for the Day-25 pipeline path + debug).
+// On any failure the shader still exists as a valid AbstractShader
+// handle (m_module == nullptr) so VideoCommon / the Software path
+// keep working — the GPU render path just won't use this one yet.
+class WebGPUShader final : public AbstractShader
+{
+public:
+  // Day-28: the real GPUShaderModule lives on the discio worker (the
+  // pthread can't own a device — Day-26). m_bridge_id is the
+  // producer-assigned id the consumer keyed its module under; 0 means
+  // translation failed / no module (Software fallback). m_wgsl kept
+  // for the Day-29 pipeline opcode + debugging.
+  WebGPUShader(ShaderStage stage, u32 bridge_id, std::string wgsl)
+      : AbstractShader(stage), m_bridge_id(bridge_id), m_wgsl(std::move(wgsl))
+  {
+  }
+  ~WebGPUShader() override = default;
+
+  u32 GetBridgeId() const { return m_bridge_id; }
+  const std::string& GetWgsl() const { return m_wgsl; }
+  BinaryData GetBinary() const override { return {}; }
+
+private:
+  u32 m_bridge_id = 0;
+  std::string m_wgsl;
+};
+
+std::unique_ptr<AbstractShader>
+WebGPUGfx::CreateShaderFromSource(ShaderStage stage, std::string_view source,
+                                  VideoCommon::ShaderIncluder* /* shader_includer */,
+                                  std::string_view /* name */)
+{
+  // Day-28: Dolphin GLSL → glslang → SPIR-V → Naga → WGSL (all C++,
+  // on this pthread — Day-22/23) → CreateShader opcode through the
+  // command ring → the discio worker builds the real
+  // GPUShaderModule on its device (Day-26 bypass). The pthread never
+  // touches a device. Any failure (translate fail / ring not ready /
+  // ring full) yields bridge_id 0 → module-less handle, Software
+  // path keeps rendering. Counters logged early to track how much of
+  // Dolphin's real shader set survives the chain.
+  m_cmd_stream.EnsureRing();
+
+  std::string wgsl_text;
+  u32 bridge_id = 0;
+  auto wgsl = GlslToWgsl(stage, source);
+  if (wgsl)
+  {
+    wgsl_text = std::move(*wgsl);
+    bridge_id = m_cmd_stream.PushCreateShader(wgsl_text.data(), wgsl_text.size(),
+                                              static_cast<u32>(stage));
+  }
+
+  if (bridge_id != 0)
+  {
+    ++m_shader_ok;
+    // Day-29/32: remember the first translatable vertex AND pixel
+    // shader so ShowImage can build a real pipeline from a real
+    // Dolphin VS+FS pair (Day-32 proves shader-interface
+    // compatibility through the bridge; Day-29 used a hand FS).
+    if (stage == ShaderStage::Vertex && m_test_vs_id == 0)
+      m_test_vs_id = bridge_id;
+    if (stage == ShaderStage::Pixel && m_test_fs_id == 0)
+      m_test_fs_id = bridge_id;
+  }
+  else
+    ++m_shader_fail;
+
+  const u32 total = m_shader_ok + m_shader_fail;
+  if (total <= 64 || (total % 256) == 0)
+  {
+    EM_ASM(
+        {
+          if (typeof console !== 'undefined')
+            console.log('[webgpu-shader] ok=' + $0 + ' fail=' + $1 +
+                        ' (stage=' + $2 + ' xlat=' + $3 + ' id=' + $4 + ') firstErr=' +
+                        (UTF8ToString($5) || '<none>'));
+        },
+        m_shader_ok, m_shader_fail, static_cast<int>(stage),
+        wgsl_text.empty() ? 0 : 1, static_cast<int>(bridge_id),
+        LastShaderTranslateError().c_str());
+  }
+
+  return std::make_unique<WebGPUShader>(stage, bridge_id, std::move(wgsl_text));
+}
+
+std::unique_ptr<AbstractShader> WebGPUGfx::CreateShaderFromBinary(ShaderStage stage,
+                                                                  const void* /* data */,
+                                                                  size_t /* length */,
+                                                                  std::string_view /* name */)
+{
+  // No SPIR-V/binary shader cache path for WebGPU (the browser only
+  // takes WGSL). Dolphin always also calls CreateShaderFromSource, so
+  // a bridge-id-0 handle here is fine.
+  return std::make_unique<WebGPUShader>(stage, 0u, std::string{});
+}
+
+// Day-33 A2: a real pipeline. m_bridge_id is the consumer-side
+// GPURenderPipeline the discio worker built from the serialized
+// AbstractPipelineConfig (0 = not yet built / shader missing — the
+// SetPipeline opcode is skipped, draw falls back like the SW hybrid).
+class WebGPUPipeline final : public AbstractPipeline
+{
+public:
+  explicit WebGPUPipeline(u32 bridge_id) : m_bridge_id(bridge_id) {}
+  u32 GetBridgeId() const { return m_bridge_id; }
+
+private:
+  u32 m_bridge_id = 0;
+};
+
+// ---- Day-33 A2: AbstractPipelineConfig → WebGPU pipeline blob -----
+//
+// Producer-side enum mapping (decided with the user): the C++ side
+// pre-maps every Dolphin pipeline-state enum to the numeric WebGPU
+// code the consumer feeds straight into createRenderPipeline, so the
+// discio worker never reasons about GameCube semantics (uniform with
+// how buffer usage / texture format are already sent). The mapping is
+// the verbatim table from DESIGN-webgpu-command-protocol; the raw
+// .hex values ride along too for consumer-side debugging.
+
+namespace
+{
+// WebGPU vertex-format codes (consumer maps code→GPUVertexFormat
+// string). Mirrors VKVertexFormat::VarToVkFormat exactly, lowered to
+// the WebGPU set (no 1-/3-component 8/16-bit formats exist in WebGPU,
+// so those round up to x2/x4 — Dolphin only emits Float xN, UByte4
+// colors and the uint8x4 posmtx in practice, none of which hit that).
+enum : u32
+{
+  WVF_FLOAT32 = 0,
+  WVF_FLOAT32X2 = 1,
+  WVF_FLOAT32X3 = 2,
+  WVF_FLOAT32X4 = 3,
+  WVF_UINT8X2 = 4,
+  WVF_UINT8X4 = 5,
+  WVF_SINT8X2 = 6,
+  WVF_SINT8X4 = 7,
+  WVF_UNORM8X2 = 8,
+  WVF_UNORM8X4 = 9,
+  WVF_SNORM8X2 = 10,
+  WVF_SNORM8X4 = 11,
+  WVF_UINT16X2 = 12,
+  WVF_UINT16X4 = 13,
+  WVF_SINT16X2 = 14,
+  WVF_SINT16X4 = 15,
+  WVF_UNORM16X2 = 16,
+  WVF_UNORM16X4 = 17,
+  WVF_SNORM16X2 = 18,
+  WVF_SNORM16X4 = 19,
+};
+
+u32 VarToWgpuVertexFormat(ComponentFormat t, int comps, bool integer)
+{
+  const bool wide = comps >= 3;  // WebGPU 8/16-bit: only x2 / x4
+  switch (t)
+  {
+  case ComponentFormat::UByte:
+    return integer ? (wide ? WVF_UINT8X4 : WVF_UINT8X2)
+                   : (wide ? WVF_UNORM8X4 : WVF_UNORM8X2);
+  case ComponentFormat::Byte:
+    return integer ? (wide ? WVF_SINT8X4 : WVF_SINT8X2)
+                   : (wide ? WVF_SNORM8X4 : WVF_SNORM8X2);
+  case ComponentFormat::UShort:
+    return integer ? (wide ? WVF_UINT16X4 : WVF_UINT16X2)
+                   : (wide ? WVF_UNORM16X4 : WVF_UNORM16X2);
+  case ComponentFormat::Short:
+    return integer ? (wide ? WVF_SINT16X4 : WVF_SINT16X2)
+                   : (wide ? WVF_SNORM16X4 : WVF_SNORM16X2);
+  case ComponentFormat::Float:
+  default:
+    return WVF_FLOAT32 + static_cast<u32>(comps <= 1 ? 0 : comps - 1);
+  }
+}
+
+// DESIGN doc blend-factor mapping. WebGPU code list (consumer):
+// 0 zero,1 one,2 src,3 1-src,4 src-alpha,5 1-src-alpha,6 dst,
+// 7 1-dst,8 dst-alpha,9 1-dst-alpha.
+u32 MapSrcFactor(SrcBlendFactor f)
+{
+  switch (f)
+  {
+  case SrcBlendFactor::Zero: return 0;
+  case SrcBlendFactor::One: return 1;
+  case SrcBlendFactor::DstClr: return 6;
+  case SrcBlendFactor::InvDstClr: return 7;
+  case SrcBlendFactor::SrcAlpha: return 4;
+  case SrcBlendFactor::InvSrcAlpha: return 5;
+  case SrcBlendFactor::DstAlpha: return 8;
+  case SrcBlendFactor::InvDstAlpha: return 9;
+  default: return 1;
+  }
+}
+u32 MapDstFactor(DstBlendFactor f)
+{
+  switch (f)
+  {
+  case DstBlendFactor::Zero: return 0;
+  case DstBlendFactor::One: return 1;
+  case DstBlendFactor::SrcClr: return 2;
+  case DstBlendFactor::InvSrcClr: return 3;
+  case DstBlendFactor::SrcAlpha: return 4;
+  case DstBlendFactor::InvSrcAlpha: return 5;
+  case DstBlendFactor::DstAlpha: return 8;
+  case DstBlendFactor::InvDstAlpha: return 9;
+  default: return 0;
+  }
+}
+
+// AbstractTextureFormat → WebGPU code. color: 0 rgba8unorm,
+// 1 bgra8unorm. depth: 0 depth24plus, 1 depth32float.
+u32 MapColorFormat(AbstractTextureFormat f)
+{
+  return f == AbstractTextureFormat::BGRA8 ? 1u : 0u;
+}
+u32 MapDepthFormat(AbstractTextureFormat f)
+{
+  switch (f)
+  {
+  case AbstractTextureFormat::D32F:
+  case AbstractTextureFormat::D32F_S8:
+  case AbstractTextureFormat::R32F:
+    return 1;  // depth32float
+  default:
+    return 0;  // depth24plus (covers D24_S8 / D16)
+  }
+}
+
+void PutU32(std::vector<u8>& b, u32 v)
+{
+  b.push_back(static_cast<u8>(v & 0xff));
+  b.push_back(static_cast<u8>((v >> 8) & 0xff));
+  b.push_back(static_cast<u8>((v >> 16) & 0xff));
+  b.push_back(static_cast<u8>((v >> 24) & 0xff));
+}
+
+// Serialize one AbstractPipelineConfig into the CreatePipelineCfg
+// blob. Layout (all u32 LE): see DESIGN doc / consumer parser.
+std::vector<u8> SerializePipelineConfig(const AbstractPipelineConfig& cfg, u32 vs_id,
+                                        u32 fs_id)
+{
+  std::vector<u8> b;
+  b.reserve(160);
+  PutU32(b, 0x57504C33);  // 'WPL3' magic
+  PutU32(b, vs_id);
+  PutU32(b, fs_id);
+
+  // Primitive topology (WebGPU: 0 point-list,1 line-list,
+  // 2 triangle-list,3 triangle-strip).
+  const PrimitiveType prim = cfg.rasterization_state.primitive;
+  u32 topology = 2;
+  switch (prim)
+  {
+  case PrimitiveType::Points: topology = 0; break;
+  case PrimitiveType::Lines: topology = 1; break;
+  case PrimitiveType::Triangles: topology = 2; break;
+  case PrimitiveType::TriangleStrip: topology = 3; break;
+  }
+  PutU32(b, topology);
+  // strip index format: 0 none, 1 uint16 (our index buffers are u16).
+  PutU32(b, topology == 3 ? 1u : 0u);
+
+  // Cull (WebGPU: 0 none,1 back,2 front; All → none + cull_all flag).
+  const CullMode cull = cfg.rasterization_state.cull_mode;
+  u32 cull_code = 0, cull_all = 0;
+  switch (cull)
+  {
+  case CullMode::None: cull_code = 0; break;
+  case CullMode::Back: cull_code = 1; break;
+  case CullMode::Front: cull_code = 2; break;
+  case CullMode::All: cull_code = 0; cull_all = 1; break;
+  }
+  PutU32(b, cull_code);
+  PutU32(b, cull_all);
+
+  // Depth. WebGPU depthCompare code 0..7 = never,less,equal,
+  // less-equal,greater,not-equal,greater-equal,always — identical
+  // ordering to Dolphin's CompareMode, so the value passes through.
+  const DepthState ds = cfg.depth_state;
+  PutU32(b, ds.test_enable);
+  PutU32(b, ds.update_enable);
+  PutU32(b, ds.test_enable ? static_cast<u32>(ds.func.Value()) : 7u);
+
+  const AbstractTextureFormat depth_fmt = cfg.framebuffer_state.depth_texture_format;
+  const u32 has_depth = depth_fmt != AbstractTextureFormat::Undefined ? 1u : 0u;
+  PutU32(b, has_depth);
+  PutU32(b, MapDepthFormat(depth_fmt));
+  PutU32(b, MapColorFormat(cfg.framebuffer_state.color_texture_format));
+
+  // Blend. LogicOp has no WebGPU equivalent — per the DESIGN doc,
+  // approximate it with blending (Dolphin's own routine) on a local
+  // copy, then serialize the resulting factors.
+  BlendingState bs = cfg.blending_state;
+  if (bs.logic_op_enable)
+    bs.ApproximateLogicOpWithBlending();
+  PutU32(b, bs.blend_enable);
+  const u32 write_mask = (bs.color_update ? 0x7u : 0u) | (bs.alpha_update ? 0x8u : 0u);
+  PutU32(b, write_mask);
+  // op: 0 add, 2 reverse-subtract (DESIGN: subtract → reverse-sub).
+  PutU32(b, bs.subtract ? 2u : 0u);
+  PutU32(b, MapSrcFactor(bs.src_factor));
+  PutU32(b, MapDstFactor(bs.dst_factor));
+  PutU32(b, bs.subtract_alpha ? 2u : 0u);
+  PutU32(b, MapSrcFactor(bs.src_factor_alpha));
+  PutU32(b, MapDstFactor(bs.dst_factor_alpha));
+
+  // Raw .hex for consumer-side debugging.
+  PutU32(b, bs.hex);
+  PutU32(b, ds.hex);
+  PutU32(b, cfg.rasterization_state.hex);
+
+  // Vertex layout — mirrors VKVertexFormat::MapAttributes exactly
+  // (single binding 0, per-vertex, ShaderAttrib locations).
+  u32 attr_count = 0;
+  std::vector<u8> attrs;
+  const PortableVertexDeclaration* decl =
+      cfg.vertex_format ? &cfg.vertex_format->GetVertexDeclaration() : nullptr;
+  auto add_attr = [&](u32 location, const AttributeFormat& a) {
+    if (!a.enable)
+      return;
+    PutU32(attrs, location);
+    PutU32(attrs, VarToWgpuVertexFormat(a.type, a.components, a.integer));
+    PutU32(attrs, static_cast<u32>(a.offset));
+    ++attr_count;
+  };
+  u32 stride = 0;
+  if (decl)
+  {
+    stride = static_cast<u32>(decl->stride);
+    add_attr(static_cast<u32>(ShaderAttrib::Position), decl->position);
+    for (u32 i = 0; i < 3; i++)
+      add_attr(static_cast<u32>(ShaderAttrib::Normal) + i, decl->normals[i]);
+    for (u32 i = 0; i < 2; i++)
+      add_attr(static_cast<u32>(ShaderAttrib::Color0) + i, decl->colors[i]);
+    for (u32 i = 0; i < 8; i++)
+      add_attr(static_cast<u32>(ShaderAttrib::TexCoord0) + i, decl->texcoords[i]);
+    add_attr(static_cast<u32>(ShaderAttrib::PositionMatrix), decl->posmtx);
+  }
+  PutU32(b, stride);
+  PutU32(b, attr_count);
+  b.insert(b.end(), attrs.begin(), attrs.end());
+  return b;
+}
+}  // namespace
+
+std::unique_ptr<AbstractPipeline>
+WebGPUGfx::CreatePipeline(const AbstractPipelineConfig& config,
+                          const void* /* cache_data */, size_t /* cache_data_length */)
+{
+  // Day-33 A2: serialize the real Dolphin pipeline state and ship it
+  // over the ring so the discio worker builds a real
+  // GPURenderPipeline (replacing the Day-32 layout:"auto" + test-FS
+  // proof). The draw path still uses the proven DrawTest opcode this
+  // session — A3/A4 wire SetPipeline/vertex buffers/bind groups — so
+  // this measures real-pipeline build coverage (the same disasm-probe
+  // methodology that took shader coverage 9%→100%).
+  m_cmd_stream.EnsureRing();
+
+  u32 bridge_id = 0;
+  const auto* vs = static_cast<const WebGPUShader*>(config.vertex_shader);
+  const auto* fs = static_cast<const WebGPUShader*>(config.pixel_shader);
+  const u32 vs_id = vs ? vs->GetBridgeId() : 0;
+  const u32 fs_id = fs ? fs->GetBridgeId() : 0;
+  if (m_cmd_stream.ready() && vs_id != 0 && fs_id != 0)
+  {
+    const std::vector<u8> blob = SerializePipelineConfig(config, vs_id, fs_id);
+    bridge_id = m_cmd_stream.PushCreatePipelineCfg(blob.data(), blob.size());
+
+    static u32 s_pcfg_ok = 0, s_pcfg_skip = 0;
+    if (bridge_id != 0)
+      ++s_pcfg_ok;
+    else
+      ++s_pcfg_skip;
+    const u32 tot = s_pcfg_ok + s_pcfg_skip;
+    if (tot <= 48 || (tot % 256) == 0)
+    {
+      EM_ASM(
+          {
+            if (typeof console !== 'undefined')
+              console.log('[webgpu-pcfg] emit ok=' + $0 + ' skip=' + $1 +
+                          ' (vs=' + $2 + ' fs=' + $3 + ' id=' + $4 + ')');
+          },
+          s_pcfg_ok, s_pcfg_skip, static_cast<int>(vs_id), static_cast<int>(fs_id),
+          static_cast<int>(bridge_id));
+    }
+  }
+
+  return std::make_unique<WebGPUPipeline>(bridge_id);
+}
+
+std::unique_ptr<NativeVertexFormat>
+WebGPUGfx::CreateNativeVertexFormat(const PortableVertexDeclaration& vtx_decl)
+{
+  return std::make_unique<NativeVertexFormat>(vtx_decl);
+}
+
+bool WebGPUGfx::BindBackbuffer(const ClearColor& clear_color)
+{
+  // Day-33 Phase C: target the canvas (fbId 0). The presenter then
+  // issues its XFB-blit utility draw into this pass; PresentBackbuffer
+  // ends + submits.
+  m_cmd_stream.EnsureRing();
+  EndPassIfOpen();
+  m_fb_color_id = 0;
+  m_fb_depth_id = 0;
+  m_clear_col[0] = clear_color[0];
+  m_clear_col[1] = clear_color[1];
+  m_clear_col[2] = clear_color[2];
+  m_clear_col[3] = clear_color[3];
+  m_pending_clear = true;
+  BeginPassIfNeeded();
+  return true;
+}
+
+void WebGPUGfx::PresentBackbuffer()
+{
+  // Day-33 Phase C: close the backbuffer pass and submit. The canvas
+  // presents implicitly (the presenter rendered the XFB into it).
+  EndPassIfOpen();
+  if (m_cmd_stream.ready())
+    m_cmd_stream.PushSubmitPresent();
+}
+
+void WebGPUGfx::ShowImage(const AbstractTexture* source_texture,
+                          const MathUtil::Rectangle<int>& source_rc)
+{
+  if (!source_texture)
+    return;
+
+  // Day-26: per-frame poll for the async pthread device. Cheap no-op
+  // once resolved. Keeps Software presenting until the GPU path lands.
+  EnsureDevice();
+
+  // Day-27: command-ring transport proof. With SupportsUtilityDrawing
+  // == false, VideoCommon's Presenter calls ShowImage and RETURNS
+  // before PresentBackbuffer — so the ring must be driven from here,
+  // the one per-frame hook we actually get. Emit one CLEAR per frame
+  // (slow time-cycled colour) through the cross-thread ring; the
+  // discio worker drains + replays it on its real device. While the
+  // ring is live it OWNS the canvas — skip the Software XFB
+  // postMessage so the two don't fight, making the transport proof
+  // unambiguous. The full AbstractGfx opcode set replaces this single
+  // CLEAR over the next sessions.
+  m_cmd_stream.EnsureRing();
+  if (m_cmd_stream.ready())
+  {
+    // Day-29: once a translatable vertex shader has crossed the
+    // bridge, build a real GPURenderPipeline from it (once) and
+    // replace the Day-27 CLEAR with an actual render-pass + draw —
+    // proving the full pipeline/draw replay path end-to-end with a
+    // real Dolphin VS+FS pair (Day-32: shader-interface compatibility
+    // through the bridge; both are real translated Dolphin shaders).
+    if (m_test_vs_id != 0 && m_test_fs_id != 0)
+    {
+      if (m_test_pipeline_id == 0)
+      {
+        m_test_pipeline_id = m_cmd_stream.PushCreatePipeline(
+            m_test_vs_id, m_test_fs_id, /*topology=*/0);
+      }
+      if (m_test_pipeline_id != 0)
+      {
+        m_cmd_stream.PushDrawTest(m_test_pipeline_id, /*vertex_count=*/3);
+        m_show_image_seen = true;
+        return;
+      }
+    }
+
+    // Until the test pipeline exists, keep the Day-27 cycling clear
+    // so the canvas isn't black and the transport stays observable.
+    const double phase = emscripten_get_now() / 1000.0;
+    const float cr = 0.5f + 0.5f * static_cast<float>(__builtin_sin(phase));
+    const float cg = 0.5f + 0.5f * static_cast<float>(__builtin_sin(phase + 2.094));
+    const float cb = 0.5f + 0.5f * static_cast<float>(__builtin_sin(phase + 4.188));
+    m_cmd_stream.PushClear(cr, cg, cb, 1.0f);
+    m_show_image_seen = true;
+    return;
+  }
+
+  // Source texture is always an SWTexture under Day-18's hybrid setup
+  // (CreateTexture returned one above). Cast unwraps to the CPU pixel
+  // storage the Software rasteriser just finished writing into.
+  const SW::SWTexture* tex = static_cast<const SW::SWTexture*>(source_texture);
+  const u32 width = static_cast<u32>(source_rc.GetWidth());
+  const u32 height = static_cast<u32>(source_rc.GetHeight());
+  if (width == 0 || height == 0)
+    return;
+
+  const u8* data = tex->GetData(0, 0);
+  // SWTexture is always RGBA8, 4 bytes per texel. The buffer is a
+  // contiguous width×height×4 block — no stride alignment to worry
+  // about on this side.
+  const size_t length = static_cast<size_t>(width) * height * 4;
+
+  // Day-20: snapshot the XFB into a WebGPUGfx-owned ring slot before
+  // posting. Day-19 posted the SWTexture pointer directly (true
+  // zero-copy) but the CPU rasteriser overwrites that buffer for the
+  // next frame while the discio worker is still reading it — visible
+  // as diagonal tear/smear in-game. A small ring of stable buffers
+  // fixes it: ShowImage memcpys into the next slot (one cheap wasm
+  // memcpy, no JS allocation / structured-clone like Day-18 had), and
+  // we only cycle back to a slot kRingSize frames later — long after
+  // the worker (driven off the same frame signal, present fps ≈ 57)
+  // has consumed it. Net cost vs Day-19: +1 linear-memory memcpy
+  // (~0.3 ms for 1.2 MB); still far cheaper than the Day-18 JS slice.
+  XfbRingSlot& slot = m_xfb_ring[m_xfb_ring_index];
+  if (slot.pixels.size() != length)
+    slot.pixels.resize(length);
+  std::memcpy(slot.pixels.data(), data, length);
+  m_xfb_ring_index = (m_xfb_ring_index + 1) % kXfbRingSize;
+
+  const u8* slot_ptr = slot.pixels.data();
+  EM_ASM(
+      {
+        const heapPtr = $0;
+        const len = $1;
+        const w = $2;
+        const h = $3;
+        if (typeof self === 'undefined' || !self.postMessage || len <= 0) return;
+        self.postMessage(
+          { type: 'webgpu-show-image', width: w, height: h, ptr: heapPtr, len: len });
+      },
+      slot_ptr, static_cast<int>(length), width, height);
+
+  if (!m_show_image_seen)
+  {
+    // Day-25 thread probe (once): is ShowImage on the device-owning
+    // discio-worker thread? If 1, the GPU pipeline can present here
+    // directly; if 0, per-frame GPU work needs a thread bridge.
+    EM_ASM({
+      if (typeof console !== 'undefined')
+        console.log('[webgpu-thread] ShowImage on discioWorker=' +
+                    ((typeof self !== 'undefined' && self.__dolphinDiscioWorker) ? 1 : 0));
+    });
+  }
+
+  m_show_image_seen = true;
+}
+
+void WebGPUGfx::ClearRegion(const MathUtil::Rectangle<int>& /* target_rc */, bool color_enable,
+                            bool /* alpha_enable */, bool /* z_enable */, u32 color, u32 /* z */)
+{
+  // Day-33 Phase C: the game's BP clear-screen. Without this the EFB
+  // depth buffer is never initialised, so every drawn primitive fails
+  // the depth test and only the load-cleared background shows (the
+  // "green"). Realise it as a fresh clear render-pass on the bound
+  // EFB framebuffer: end the open pass, set the clear colour from the
+  // game's ARGB value, and begin a loadOp=clear pass (the consumer
+  // also clears depth to 1.0 on a clear pass). Subsequent draws then
+  // render into the freshly-cleared EFB.
+  if (!m_cmd_stream.ready())
+    return;
+  EndPassIfOpen();
+  if (color_enable)
+  {
+    m_clear_col[0] = static_cast<float>((color >> 16) & 0xff) / 255.0f;
+    m_clear_col[1] = static_cast<float>((color >> 8) & 0xff) / 255.0f;
+    m_clear_col[2] = static_cast<float>(color & 0xff) / 255.0f;
+    m_clear_col[3] = static_cast<float>((color >> 24) & 0xff) / 255.0f;
+  }
+  else
+  {
+    m_clear_col[0] = m_clear_col[1] = m_clear_col[2] = 0.0f;
+    m_clear_col[3] = 1.0f;
+  }
+  m_pending_clear = true;
+  BeginPassIfNeeded();
+}
+
+void WebGPUGfx::SetScissorRect(const MathUtil::Rectangle<int>& rc)
+{
+  m_scissor[0] = static_cast<u32>(std::max(0, rc.left));
+  m_scissor[1] = static_cast<u32>(std::max(0, rc.top));
+  m_scissor[2] = static_cast<u32>(std::max(0, rc.GetWidth()));
+  m_scissor[3] = static_cast<u32>(std::max(0, rc.GetHeight()));
+  if (m_pass_open && m_scissor[2] > 0 && m_scissor[3] > 0)
+    m_cmd_stream.PushSetScissor(m_scissor[0], m_scissor[1], m_scissor[2], m_scissor[3]);
+}
+
+// ---- Day-33 A3/A4/A5: real render-path recording -----------------
+
+// GPUBufferUsage: UNIFORM 0x40, STORAGE 0x80, COPY_DST 0x8.
+static constexpr u32 kUsageUniform = 0x40 | 0x8;
+static constexpr u32 kUsageStorage = 0x80 | 0x8;
+
+void WebGPUGfx::EndPassIfOpen()
+{
+  if (m_pass_open)
+  {
+    m_cmd_stream.PushEndPass();
+    m_pass_open = false;
+  }
+}
+
+void WebGPUGfx::BeginPassIfNeeded()
+{
+  if (m_pass_open)
+    return;
+  m_cmd_stream.PushBeginPass(m_fb_color_id, m_clear_col[0], m_clear_col[1], m_clear_col[2],
+                             m_clear_col[3], m_pending_clear ? 1u : 0u, m_fb_depth_id);
+  m_pending_clear = false;
+  m_pass_open = true;
+  // A fresh WebGPU pass resets viewport/scissor — re-emit cached.
+  m_cmd_stream.PushSetViewport(m_viewport[0], m_viewport[1], m_viewport[2], m_viewport[3],
+                               m_viewport[4], m_viewport[5]);
+  if (m_scissor[2] > 0 && m_scissor[3] > 0)
+    m_cmd_stream.PushSetScissor(m_scissor[0], m_scissor[1], m_scissor[2], m_scissor[3]);
+  m_last_set_pipeline_id = 0;  // pipeline binding is per-pass
+}
+
+static void PutBgU32(std::vector<u8>& b, u32 v)
+{
+  b.push_back(static_cast<u8>(v));
+  b.push_back(static_cast<u8>(v >> 8));
+  b.push_back(static_cast<u8>(v >> 16));
+  b.push_back(static_cast<u8>(v >> 24));
+}
+
+void WebGPUGfx::PrepareDrawResources()
+{
+  auto& system = Core::System::GetInstance();
+
+  // §16 per-draw uniform ring (created once). One big buffer; each
+  // dirty GX constant set bump-allocates a fresh 256-aligned slice so
+  // a later draw's upload can't overwrite this draw's constants.
+  if (m_ubo_ring == 0)
+    m_ubo_ring = m_cmd_stream.PushCreateBuffer(kUboRingSize, kUsageUniform);
+  if (m_ssbo_bbox == 0)
+    m_ssbo_bbox = m_cmd_stream.PushCreateBuffer(16u, kUsageStorage);
+  if (m_dummy_tex == 0)
+  {
+    // 1x1 RGBA8 (fmt code 0), usage TEXTURE_BINDING|COPY_DST|... so the
+    // fixed group-1 layout is always satisfiable for unbound slots.
+    m_dummy_tex = m_cmd_stream.PushCreateTexture(1, 1, 0, 1u | 2u | 4u | 0x10u);
+  }
+
+  auto& vsm = system.GetVertexShaderManager();
+  {
+    // DIAG one-shot: is the VS UBO actually populated? Dump dirty +
+    // posnormalmatrix row0 + projection rows + the live viewport. A
+    // zero projection (or never-dirty → never-uploaded UBO) collapses
+    // every vertex → black EFB (geometry executes, rasterises nothing).
+    static u32 s_diag_vs = 0;
+    const u32 s_diag_n = s_diag_vs++;
+    if (s_diag_n < 3 || (s_diag_n % 1200) == 0)
+    {
+      // VertexShaderConstants: 4×u32 + float4 missing_color_value
+      // (8 floats) header, then posnormalmatrix[6] @ float offset 8,
+      // projection[4] @ float offset 32.
+      const float* f = reinterpret_cast<const float*>(&vsm.constants);
+      EM_ASM(
+          {
+            console.log('[webgpu-DIAG-vs] dirty=' + $0 +
+              ' pnm0=' + HEAPF32[($1>>2)+8].toFixed(3) + ',' +
+                         HEAPF32[($1>>2)+9].toFixed(3) + ',' +
+                         HEAPF32[($1>>2)+10].toFixed(3) + ',' +
+                         HEAPF32[($1>>2)+11].toFixed(3) +
+              ' proj0=' + HEAPF32[($1>>2)+32].toFixed(3) + ',' +
+                          HEAPF32[($1>>2)+33].toFixed(3) + ',' +
+                          HEAPF32[($1>>2)+34].toFixed(3) + ',' +
+                          HEAPF32[($1>>2)+35].toFixed(3) +
+              ' proj3=' + HEAPF32[($1>>2)+44].toFixed(3) + ',' +
+                          HEAPF32[($1>>2)+45].toFixed(3) + ',' +
+                          HEAPF32[($1>>2)+46].toFixed(3) + ',' +
+                          HEAPF32[($1>>2)+47].toFixed(3) +
+              ' vp=' + HEAPF32[($2>>2)+0].toFixed(1) + ',' +
+                       HEAPF32[($2>>2)+1].toFixed(1) + ',' +
+                       HEAPF32[($2>>2)+2].toFixed(1) + ',' +
+                       HEAPF32[($2>>2)+3].toFixed(1) + ',' +
+                       HEAPF32[($2>>2)+4].toFixed(3) + ',' +
+                       HEAPF32[($2>>2)+5].toFixed(3) +
+              // §28an: texgen source. texmatrices[24] @byte896
+              // (float idx 224) = VSBlock member_9; the menu UV =
+              // dot(vtx, texmatrices[0..1]). post[0]=member_12 @
+              // byte1280 (idx 320). comp = components(.x)/
+              // dualTexInfo(.y)/numColorChans(.z) header @byte0.
+              ' comp=' + HEAP32[($1>>2)+0] + ',' + HEAP32[($1>>2)+1] +
+                   ',' + HEAP32[($1>>2)+2] +
+              ' texm0=' + HEAPF32[($1>>2)+224].toFixed(4) + ',' +
+                          HEAPF32[($1>>2)+225].toFixed(4) + ',' +
+                          HEAPF32[($1>>2)+226].toFixed(4) + ',' +
+                          HEAPF32[($1>>2)+227].toFixed(4) +
+              ' texm1=' + HEAPF32[($1>>2)+228].toFixed(4) + ',' +
+                          HEAPF32[($1>>2)+229].toFixed(4) + ',' +
+                          HEAPF32[($1>>2)+230].toFixed(4) + ',' +
+                          HEAPF32[($1>>2)+231].toFixed(4) +
+              ' post0=' + HEAPF32[($1>>2)+320].toFixed(4) + ',' +
+                          HEAPF32[($1>>2)+321].toFixed(4) + ',' +
+                          HEAPF32[($1>>2)+322].toFixed(4) + ',' +
+                          HEAPF32[($1>>2)+323].toFixed(4));
+          },
+          vsm.dirty ? 1 : 0, reinterpret_cast<intptr_t>(f),
+          reinterpret_cast<intptr_t>(&m_viewport[0]));
+    }
+  }
+  // Allocate a fresh ring slice only when a manager is dirty (or on
+  // first use) — an unchanged class keeps its slice, so the upload
+  // rate stays as low as the old dirty model while every *distinct*
+  // constant set gets its own un-clobbered slice.
+  // §20: re-slice when the WHOLE VS constant block differs from the
+  // last upload (immune to any missed-`dirty` path — projection §19,
+  // posmtx/texmtx for 2D UI, etc.). sizeof(vsm.constants) ≤
+  // kUboSliceStride (the shadow's size).
+  static_assert(sizeof(vsm.constants) <= sizeof(m_vs_shadow),
+                "VS shadow must cover VertexShaderConstants");
+  const bool vs_changed =
+      !m_vs_shadow_valid ||
+      std::memcmp(m_vs_shadow.data(), &vsm.constants,
+                  sizeof(vsm.constants)) != 0;
+  if (vsm.dirty || m_vs_off == kUboOffNone || vs_changed)
+  {
+    m_vs_off = AllocUboSlice(&vsm.constants, sizeof(vsm.constants));
+    vsm.dirty = false;
+    std::memcpy(m_vs_shadow.data(), &vsm.constants, sizeof(vsm.constants));
+    m_vs_shadow_valid = true;
+  }
+  // §21: same draw-time whole-block diff as §20, for PS (TEV /
+  // PixelShaderConstants) and GS. The §16 per-draw-clobber family also
+  // afflicts pixel constants: psm.dirty is consumed/skipped on paths
+  // that still mutate TEV state, so dirty-gated slicing left most
+  // textured draws on a stale PS slice → only the few whose TEV config
+  // matched the last upload rendered ("only pieces"; e.g. the
+  // highlighted "VERY EASY" while the rest of the screen stayed
+  // black). Content diff is immune to every missed-dirty path.
+  auto& psm = system.GetPixelShaderManager();
+  static_assert(sizeof(psm.constants) <= sizeof(m_ps_shadow),
+                "PS shadow must cover PixelShaderConstants");
+  const bool ps_changed =
+      !m_ps_shadow_valid ||
+      std::memcmp(m_ps_shadow.data(), &psm.constants,
+                  sizeof(psm.constants)) != 0;
+  if (psm.dirty || m_ps_off == kUboOffNone || ps_changed)
+  {
+    m_ps_off = AllocUboSlice(&psm.constants, sizeof(psm.constants));
+    psm.dirty = false;
+    std::memcpy(m_ps_shadow.data(), &psm.constants, sizeof(psm.constants));
+    m_ps_shadow_valid = true;
+  }
+#ifdef __EMSCRIPTEN__
+  // §28ah decisive probe: is the menu/difficulty-select TEV colour
+  // register zero at SOURCE (PixelShaderManager) or only in delivery?
+  // fs#16081 reads colors[1] (member[1]) & kcolors[0] (member_1[0]);
+  // colors @byte0, kcolors @byte64 of PixelShaderConstants. Log them
+  // + ps_changed/dirty + m_ps_off so a dark-menu frame shows whether
+  // Dolphin computed them ≈0 (state/shadergen) or they're non-zero
+  // here (⇒ ring-slice/binding/layout delivery defect).
+  {
+    static u32 s_ps = 0;
+    const u32 n = s_ps++;
+    if (n < 6 || (n % 240) == 0)
+    {
+      const int* c = reinterpret_cast<const int*>(&psm.constants);
+      // colors[i] = ints [i*4..]; kcolors[i] = ints [16 + i*4..].
+      EM_ASM(
+          {
+            console.log('[s28ah-ps] n=' + $0 + ' t=' +
+              performance.now().toFixed(0) + ' chg=' + $1 +
+              ' psOff=' + $2 +
+              ' col0=' + HEAP32[($3>>2)+0] + ',' + HEAP32[($3>>2)+1] +
+                  ',' + HEAP32[($3>>2)+2] + ',' + HEAP32[($3>>2)+3] +
+              ' col1=' + HEAP32[($3>>2)+4] + ',' + HEAP32[($3>>2)+5] +
+                  ',' + HEAP32[($3>>2)+6] + ',' + HEAP32[($3>>2)+7] +
+              ' kcol0=' + HEAP32[($3>>2)+16] + ',' + HEAP32[($3>>2)+17] +
+                  ',' + HEAP32[($3>>2)+18] + ',' + HEAP32[($3>>2)+19] +
+              ' kcol1=' + HEAP32[($3>>2)+20] + ',' + HEAP32[($3>>2)+21] +
+                  ',' + HEAP32[($3>>2)+22] + ',' + HEAP32[($3>>2)+23]);
+          },
+          n, ps_changed ? 1 : 0, m_ps_off,
+          reinterpret_cast<intptr_t>(c));
+    }
+  }
+#endif
+  auto& gsm = system.GetGeometryShaderManager();
+  static_assert(sizeof(gsm.constants) <= sizeof(m_gs_shadow),
+                "GS shadow must cover GeometryShaderConstants");
+  const bool gs_changed =
+      !m_gs_shadow_valid ||
+      std::memcmp(m_gs_shadow.data(), &gsm.constants,
+                  sizeof(gsm.constants)) != 0;
+  if (gsm.dirty || m_gs_off == kUboOffNone || gs_changed)
+  {
+    m_gs_off = AllocUboSlice(&gsm.constants, sizeof(gsm.constants));
+    gsm.dirty = false;
+    std::memcpy(m_gs_shadow.data(), &gsm.constants, sizeof(gsm.constants));
+    m_gs_shadow_valid = true;
+  }
+
+  // One shared sampler (the Day-30 split uses a single samp_ss).
+  if (m_sampler_id == 0)
+    m_sampler_id = m_cmd_stream.PushCreateSampler(/*linear+repeat=*/0);
+
+  // Bind group 0 — the uniform ring at all 4 UBO bindings (b0 PS /
+  // utility PSBlock, b1 VS, b2 custom→reuse PS, b3 GS). Built ONCE: the
+  // per-draw constants live at per-draw *dynamic offsets* into the ring
+  // (carried on SET_BIND_GROUP), not in the bind group, so this one
+  // bind group serves every draw. Entry size = each class's block size
+  // (the dynamic-offset window WebGPU validates).
+  if (m_bg0_id == 0 && m_ubo_ring != 0)
+  {
+    const u32 ps_sz = static_cast<u32>(sizeof(PixelShaderConstants));
+    const u32 vs_sz = static_cast<u32>(sizeof(VertexShaderConstants));
+    const u32 gs_sz = static_cast<u32>(sizeof(GeometryShaderConstants));
+    std::vector<u8> b;
+    PutBgU32(b, 0x57424731);  // 'WBG1'
+    PutBgU32(b, 0);           // group index
+    PutBgU32(b, 4);           // entry count
+    // {binding, kind=0 buffer, resId=ring, offset=0, size=classBytes}
+    const u32 ents[4][5] = {{0, 0, m_ubo_ring, 0, ps_sz},
+                            {1, 0, m_ubo_ring, 0, vs_sz},
+                            {2, 0, m_ubo_ring, 0, ps_sz},
+                            {3, 0, m_ubo_ring, 0, gs_sz}};
+    for (auto& e : ents)
+      for (u32 v : e)
+        PutBgU32(b, v);
+    m_bg0_id = m_cmd_stream.PushCreateBindGroup(b.data(), b.size(), 0);
+  }
+  if (m_bg0_id)
+  {
+    // 4 dynamic offsets in binding order: b0 = PS (or the utility
+    // PSBlock slice for a utility draw), b1 = VS, b2 = custom (reuse
+    // PS), b3 = GS. kUboOffNone shouldn't reach here (forced-allocated
+    // above) but clamp to 0 defensively so the offset stays valid.
+    auto off = [](u32 o) { return o == kUboOffNone ? 0u : o; };
+    const u32 b0 = off(m_util_uniform_mode ? m_util_off : m_ps_off);
+    const u32 dyn[4] = {b0, off(m_vs_off), b0, off(m_gs_off)};
+#ifdef __EMSCRIPTEN__
+    // §28ac decisive probe (i): at a utility draw's SET_BIND_GROUP(0),
+    // is b0 the util slice (m_util_off, correct) or a stale m_ps_off?
+    // Pair with [s28ac-uu] (same utilOff value ⇒ the copy reads the
+    // bytes TextureCacheBase wrote). fbColor/vp identify the 640×480
+    // EFB-copy target.
+    if (m_util_uniform_mode)
+    {
+      static u32 s_pd = 0;
+      const u32 n = s_pd++;
+      if (n < 8 || (n % 120) == 0)
+      {
+        EM_ASM(
+            {
+              console.log('[s28ac-bg] n=' + $0 + ' t=' +
+                performance.now().toFixed(0) + ' b0=' + $1 +
+                ' utilOff=' + $2 + ' psOff=' + $3 + ' vsOff=' + $4 +
+                ' fbColor=' + $5 + ' vp=' + $6 + 'x' + $7);
+            },
+            n, b0, m_util_off, m_ps_off, m_vs_off, m_fb_color_id,
+            static_cast<int>(m_viewport[2]),
+            static_cast<int>(m_viewport[3]));
+      }
+    }
+#endif
+    m_cmd_stream.PushSetBindGroup(0, m_bg0_id, dyn, 4);
+  }
+
+  // Bind group 1 — samplers (b0..7 textures, b8 sampler). Rebuild
+  // only when the bound texture/sampler set OR the render target
+  // changes. A sampler slot that references the *current* render
+  // target (EFB feedback) is a WebGPU read-while-write hazard
+  // ("writable usage and another usage in the same synchronization
+  // scope") — substitute the dummy texture for it; a genuine EFB
+  // copy renders into a different target so its id won't match.
+  auto resolve_tex = [&](u32 i) -> u32 {
+    const u32 t = m_tex_id[i];
+    if (t == 0 || t == m_fb_color_id || t == m_fb_depth_id)
+      return m_dummy_tex;
+    return t;
+  };
+  u32 sig = m_sampler_id * 2654435761u + m_fb_color_id * 40503u + m_fb_depth_id;
+  for (u32 i = 0; i < 8; i++)
+    sig = sig * 16777619u + resolve_tex(i);
+  Bg1Slot& slot = m_bg1_cache[sig % kBg1CacheSize];
+  u32 bg1_id = (slot.id != 0 && slot.sig == sig) ? slot.id : 0;
+  if (bg1_id == 0)
+  {
+    std::vector<u8> b;
+    PutBgU32(b, 0x57424731);
+    PutBgU32(b, 1);
+    PutBgU32(b, 9);
+    for (u32 i = 0; i < 8; i++)
+    {
+      PutBgU32(b, i);
+      PutBgU32(b, 1);
+      PutBgU32(b, resolve_tex(i));
+      PutBgU32(b, 0);
+      PutBgU32(b, 0);
+    }
+    PutBgU32(b, 8);
+    PutBgU32(b, 2);
+    PutBgU32(b, m_sampler_id);
+    PutBgU32(b, 0);
+    PutBgU32(b, 0);
+    const u32 id = m_cmd_stream.PushCreateBindGroup(b.data(), b.size(), 1);
+    if (id)
+    {
+      slot.id = id;  // evicts any colliding entry (harmless rebuild)
+      slot.sig = sig;
+      bg1_id = id;
+    }
+  }
+  if (bg1_id)
+    m_cmd_stream.PushSetBindGroup(1, bg1_id);
+
+  // Bind group 2 — bbox SSBO (b0). Fixed ⇒ build once, reuse.
+  if (m_bg2_id == 0)
+  {
+    std::vector<u8> b;
+    PutBgU32(b, 0x57424731);
+    PutBgU32(b, 2);
+    PutBgU32(b, 1);
+    PutBgU32(b, 0);
+    PutBgU32(b, 3);
+    PutBgU32(b, m_ssbo_bbox);
+    PutBgU32(b, 0);
+    PutBgU32(b, 0);
+    m_bg2_id = m_cmd_stream.PushCreateBindGroup(b.data(), b.size(), 2);
+  }
+  if (m_bg2_id)
+    m_cmd_stream.PushSetBindGroup(2, m_bg2_id);
+}

+bool IsPairedSingleArithmeticSubop(u32 subop5)
+{
+  return subop5 == 12 || subop5 == 13 || subop5 == 14 || subop5 == 15 ||
+         subop5 == 20 || subop5 == 21 || subop5 == 25 || subop5 == 28 ||
+         subop5 == 29 || subop5 == 30 || subop5 == 31;

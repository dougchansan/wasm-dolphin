+
+void WebGPUCommandStream::PushSetBindGroup(u32 slot, u32 bg_id, const u32* dyn_offsets,
+                                           u32 num_dyn)
+{
+  if (!m_header || bg_id == 0)
+    return;
+  CmdRecord rec{};
+  rec.op = static_cast<u32>(CmdOp::SetBindGroup);
+  rec.arg.u[0] = slot;
+  rec.arg.u[1] = bg_id;
+  // arg.u[2]=count, arg.u[3..6]=offsets. CmdRecord has 7 u32 args, so
+  // at most 4 dynamic offsets fit (group0's 4 UBO bindings).
+  if (num_dyn > 4)
+    num_dyn = 4;
+  rec.arg.u[2] = num_dyn;
+  for (u32 i = 0; i < num_dyn; i++)
+    rec.arg.u[3 + i] = dyn_offsets[i];
+  Push(rec);
+}

+void WebGPUGfx::SetPipeline(const AbstractPipeline* pipeline)
+{
+  m_cur_pipeline_id =
+      pipeline ? static_cast<const WebGPUPipeline*>(pipeline)->GetBridgeId() : 0;
+}
+
+void WebGPUGfx::SetFramebuffer(AbstractFramebuffer* framebuffer)
+{
+  AbstractGfx::SetFramebuffer(framebuffer);
+  EndPassIfOpen();
+  if (framebuffer)
+  {
+    const auto* c = static_cast<const WebGPUTexture*>(framebuffer->GetColorAttachment());
+    const auto* d = static_cast<const WebGPUTexture*>(framebuffer->GetDepthAttachment());
+    m_fb_color_id = c ? c->GetBridgeId() : 0;
+    m_fb_depth_id = d ? d->GetBridgeId() : 0;
+  }
+  else
+  {
+    m_fb_color_id = 0;  // backbuffer
+    m_fb_depth_id = 0;
+  }
+  m_pending_clear = false;
+}
+
+void WebGPUGfx::SetAndDiscardFramebuffer(AbstractFramebuffer* framebuffer)
+{
+  SetFramebuffer(framebuffer);
+}
+
+void WebGPUGfx::SetAndClearFramebuffer(AbstractFramebuffer* framebuffer,
+                                       const ClearColor& color_value, float /* depth_value */)
+{
+  SetFramebuffer(framebuffer);
+  m_pending_clear = true;
+  m_clear_col[0] = color_value[0];
+  m_clear_col[1] = color_value[1];
+  m_clear_col[2] = color_value[2];
+  m_clear_col[3] = color_value[3];
+  // Begin immediately so the clear happens even with no draws.
+  BeginPassIfNeeded();
+}
+
+void WebGPUGfx::SetViewport(float x, float y, float width, float height, float near_depth,
+                            float far_depth)
+{
+  m_viewport[0] = x;
+  m_viewport[1] = y;
+  m_viewport[2] = width;
+  m_viewport[3] = height;
+  m_viewport[4] = near_depth;
+  m_viewport[5] = far_depth;
+  if (m_pass_open && width > 0 && height > 0)
+    m_cmd_stream.PushSetViewport(x, y, width, height, near_depth, far_depth);
+}

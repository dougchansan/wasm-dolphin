diff --git a/Source/Core/Core/PowerPC/JitCommon/JitCache.h b/Source/Core/Core/PowerPC/JitCommon/JitCache.h
index 4b5ac6f..9e924b9 100644
--- a/Source/Core/Core/PowerPC/JitCommon/JitCache.h
+++ b/Source/Core/Core/PowerPC/JitCommon/JitCache.h
@@ -140,6 +140,40 @@ public:
   void Clear(u32 bit) { m_valid_block[bit / 32] &= ~(1u << (bit % 32)); }
   void ClearAll() { memset(m_valid_block.get(), 0, sizeof(u32) * VALID_BLOCK_ALLOC_ELEMENTS); }
   bool Test(u32 bit) const { return (m_valid_block[bit / 32] & (1u << (bit % 32))) != 0; }
+
+  bool ClearRangeAndTestAny(u32 first_bit, u32 end_bit)
+  {
+    if (first_bit >= end_bit)
+      return false;
+
+    const u32 first_word = first_bit / 32;
+    const u32 last_word = (end_bit - 1) / 32;
+    const u32 first_mask = ~0u << (first_bit % 32);
+    const u32 last_mask_bits = end_bit % 32;
+    const u32 last_mask = last_mask_bits == 0 ? ~0u : (1u << last_mask_bits) - 1;
+    bool any = false;
+
+    if (first_word == last_word)
+    {
+      const u32 mask = first_mask & last_mask;
+      any = (m_valid_block[first_word] & mask) != 0;
+      m_valid_block[first_word] &= ~mask;
+      return any;
+    }
+
+    any |= (m_valid_block[first_word] & first_mask) != 0;
+    m_valid_block[first_word] &= ~first_mask;
+
+    for (u32 word = first_word + 1; word < last_word; ++word)
+    {
+      any |= m_valid_block[word] != 0;
+      m_valid_block[word] = 0;
+    }
+
+    any |= (m_valid_block[last_word] & last_mask) != 0;
+    m_valid_block[last_word] &= ~last_mask;
+    return any;
+  }
 };
 

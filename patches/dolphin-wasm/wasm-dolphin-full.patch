+    GenerateAlignmentException(ppc_state, address);
+  }
+  else
+  {
+    const u64 temp = Core::System::GetInstance().GetMMU().Read<u64>(address);
+    if ((ppc_state.Exceptions & EXCEPTION_DSI) == 0)
+      ppc_state.ps[fd].SetPS0(temp);

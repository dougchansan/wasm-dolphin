+u32 MapFastMeleeStatusDispatchResult(u32 raw_status)
+{
+  const u32 index = raw_status + 1;
+  if (index > 12)
+    return 0xffffffff;
+
+  switch (index)
+  {
+  case 0:
+    return 4;
+  case 2:
+    return 5;
+  case 5:
+    return 1;
+  case 6:
+    return 0;
+  case 7:
+    return 2;
+  case 12:
+    return 3;
+  default:
+    return 0xffffffff;
+  }
+}

       });
 }
 
+// wasm-dolphin (§24): synchronous save. SaveAs queues SaveAsFromCore
+// onto the CPU thread, which then hands the buffer to the async
+// s_compress_and_dump_thread WorkQueueThread — under the discio
+// worker's pthread layout that dump thread gets no wall-time during
+// the tight runFrame poll, so the file never flushed (§23 size=0).
+// Here the dump runs INLINE on the CPU thread (CompressAndDumpState
+// directly, no EmplaceItem), so the file is fully written within the
+// single CPU-thread job execution; the caller only has to pump frames
+// until the CPU thread picks the job up — no dump-thread scheduling.
+void SaveToFileSync(Core::System& system, std::string filename)
+{
+  Core::RunOnCPUThread(
+      system, [&system, filename = std::move(filename), lock = GetStateSaveTaskLock()]() mutable {
+        const auto buffer_size_estimate = std::size_t(s_last_state_size) * 110 / 100;
+        Common::UniqueBuffer<u8> buffer{buffer_size_estimate};
+        if (const auto actual_size = SaveToBuffer(system, buffer))
+        {
+          buffer.assign(buffer.extract().first, actual_size);
+          CompressAndDumpStateArgs dump_args{
+              .buffer = std::move(buffer),
+              .filename = std::move(filename),
+              .task_lock = std::move(lock),
+          };
+          CompressAndDumpState(system, dump_args);
+        }
+        else
+        {
+          Core::DisplayMessage("Unable to save: Internal DoState Error", 4000);
+        }
+      });
+}
